diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
index f8ba0f1..01f1f47 100644
--- a/.github/workflows/pages.yml
+++ b/.github/workflows/pages.yml
@@ -1,10 +1,11 @@
 name: Deploy Playground to Pages
 
-# NOTE (SVM migration): this builds the playground on the OLD backend.
-# build_wasm.sh compiles src/jacl.c (embed.c -> jacl_eval), i.e. the
-# in-tree compiler+VM. The new SVM backend (codegen/ + runtime/ +
-# vendor/svm) has no wasm embedding yet, so the playground can't run on
-# it. Retarget the wasm build here once an SVM->wasm path exists.
+# Builds BOTH backends and ships them side by side:
+#   - Classic: build_wasm.sh → src/jacl.c (jacl_eval), the in-tree compiler+VM.
+#   - SVM (the migration target): the wasm-safe bytecode engine. The playground's
+#     "Engine: SVM" toggle runs edited source client-side — jacl_emit.wasm (the
+#     LLVM-free frontend → SVM IR) → svm_link_run_jacl in svm_browser.wasm (link vs
+#     jaclrt.svm + run). See demo/svm/README.md.
 
 on:
   push:
@@ -29,6 +30,8 @@ jobs:
     steps:
       - name: Checkout
         uses: actions/checkout@v4
+        with:
+          submodules: recursive   # vendor/svm — the cdylib + svm-llvm for the SVM backend
 
       - name: Setup Node
         uses: actions/setup-node@v4
@@ -41,10 +44,26 @@ jobs:
           version: latest
           actions-cache-folder: emsdk-cache
 
-      # Produces build_wasm/jacl.js + build_wasm/jacl.wasm.
+      - name: Setup Rust (wasm32 for the svm-browser cdylib)
+        uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: wasm32-unknown-unknown
+
+      - name: Install clang/LLVM 18 (svm-llvm bakes jaclrt.svm)
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y clang-18 llvm-18-dev libclang-18-dev
+          echo "/usr/lib/llvm-18/bin" >> "$GITHUB_PATH"
+
+      # Produces build_wasm/jacl.js + build_wasm/jacl.wasm (the Classic backend).
       - name: Build WASM module
         run: bash build_wasm.sh
 
+      # Produces the SVM backend assets: svm_browser.wasm + jacl_emit.{js,wasm} + jaclrt.svm
+      # (+ a couple precompiled example .svmb). Reuses the same script the docs describe.
+      - name: Build SVM assets
+        run: bash demo/svm/build_assets.sh
+
       # Symlinks wasm/, bundles the CodeMirror editor via esbuild
       # (npm ci on first run), and regenerates examples.json from
       # test/jacl/*.jacl. Produces demo/dist/playground.js.
@@ -58,12 +77,19 @@ jobs:
       - name: Assemble site
         run: |
           rm -rf _site
-          mkdir -p _site/wasm _site/dist
+          mkdir -p _site/wasm _site/dist _site/svm/svmb
           cp demo/index.html      _site/index.html
           cp demo/examples.json   _site/examples.json
           cp demo/dist/playground.js _site/dist/playground.js
+          # Classic backend
           cp build_wasm/jacl.js   _site/wasm/jacl.js
           cp build_wasm/jacl.wasm _site/wasm/jacl.wasm
+          # SVM backend: cdylib + in-browser frontend + runtime blob + precompiled examples
+          cp demo/wasm/svm_browser.wasm _site/wasm/svm_browser.wasm
+          cp demo/wasm/jacl_emit.js     _site/wasm/jacl_emit.js
+          cp demo/wasm/jacl_emit.wasm   _site/wasm/jacl_emit.wasm
+          cp demo/svm/jaclrt.svm        _site/svm/jaclrt.svm
+          cp -r demo/svm/svmb/.         _site/svm/svmb/ 2>/dev/null || true
 
       - name: Upload Pages artifact
         uses: actions/upload-pages-artifact@v3
