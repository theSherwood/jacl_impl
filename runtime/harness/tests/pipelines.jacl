# mode: concurrent
##
## pipelines.jacl — `!a | !b` across child vats (docs/UNIR_PIPELINES.md, theSherwood/unir#19).
## Self-checking. Run by codegen.rs::pipelines_run_on_temen, which grants the programs in
## tests/pipelines/ as `bin.<name>`, and checks what reached the host's stdout.
##

# A `$ctx` field the stages must not see (docs/CTX_ENV.md).
ctx str secret ""

# A JACL stage: the byte count of a read end, or its error.
proc count {ch} {
  mut n 0
  mut b [read $ch 1016]
  while [!= $b $nil] {
    if [error? $b] { return $b }
    set n [+ $n [buf-len $b]]
    set b [read $ch 1016]
  }
  $n
}

# A JACL stage: checks that a read end carries `forever`'s alphabet uppercased, in order, and
# keeps the count in the atom N.
proc tally {ch n} {
  mut k 0
  mut b [read $ch 1016]
  while [!= $b $nil] {
    if [error? $b] { return $b }
    mut i 0
    while [< $i [buf-len $b]] {
      if [!= [buf-get $b $i] [+ 65 [% $k 26]]] { return [error "out of order"] }
      set k [+ $k 1]
      set i [+ $i 1]
    }
    reset $n $k
    set b [read $ch 1016]
  }
  $k
}

# A JACL stage over a typed output: the sum of the integers it reads, as values.
proc sumvals {ch} {
  mut t 0
  mut v [read $ch 1]
  while [!= $v $nil] {
    if [error? $v] { return $v }
    set t [+ $t $v]
    set v [read $ch 1]
  }
  $t
}

# Waits until the atom N passes K.
proc wait-past {n k} {
  while [<= [deref $n] $k] { sleep 0.001 }
}

proc main {} {
  # Two vats and an edge between them; `collect` reads the last stage's stdout into a string.
  def out {!gen hello world | !upcase | collect}
  assert [== [length $out] 600]
  assert [== [slice $out 0 12] "HELLO\nWORLD\n"]

  # One stage, and three.
  def one {!gen ab | collect}
  assert [== [length $one] 150]
  def three {!gen ab | !upcase | !upcase | collect}
  assert [== [slice $three 0 6] "AB\nAB\n"]

  # Any JACL stage reads the output as a channel.
  def cnt {!gen ab | !upcase | count}
  assert [== $cnt 150]

  # In value position the output goes to the enclosing output (here the host's stdout, which
  # the harness checks) and the value is the last program's value; in statement position, the
  # same.
  def r {!gen hi | !upcase}
  assert [== $r 0]
  def r1 {!gen q}
  assert [== $r1 0]
  !gen side

  # A stage that fails fails the pipeline (pipefail) with its own error value; the stage after
  # it sees a sever, and the one before it a cancelled stdout. So in value position, and so for
  # its reader.
  def bad {!gen x | !fail | !upcase}
  assert [error? $bad]
  assert [== [error-val $bad] "boom"]
  def badc {!gen x | !fail | !upcase | collect}
  assert [== [error-val $badc] "boom"]
  def badn {!gen x | !fail | count}
  assert [== [error-val $badn] "boom"]

  # Values cross (theSherwood/unir#43): a program's value comes back as the value it returned,
  # maps, vectors and errors included, and its arguments arrive as the values passed.
  def all {!value all}
  assert [== [map-get $all "i"] 7]
  assert [== [map-get $all "big"] 5000000000]
  assert [== [map-get $all "neg"] -7]
  assert [== [map-get $all "f"] 1.5]
  assert [== [map-get $all "s"] "longer than seven bytes"]
  assert [== [map-get $all "t"] $true]
  assert [map-has $all "n"]
  assert [== [map-get $all "n"] $nil]
  def v [map-get $all "v"]
  assert [== [vec-len $v] 3]
  assert [== [vec-get [vec-get $v 1] 1] 3]
  assert [== [vec-get $v 2] "x"]
  assert [== [map-get [map-get $all "m"] "k"] "v"]
  def e {!value err}
  assert [error? $e]
  assert [== [map-get [error-val $e] "code"] 3]
  assert [== [map-get [error-val $e] "why"] "because"]
  assert [error? {!value "atom"}]
  def xs [vec 1 2]
  def a {!value "args" 42 $xs [map k 5000000000]}
  assert [== [vec-get $a 0] "value"]
  assert [== [vec-get $a 2] 42]
  assert [== [vec-get [vec-get $a 3] 1] 2]
  assert [== [map-get [vec-get $a 4] "k"] 5000000000]
  # A pipeline's value is its last program's.
  assert [== {!gen x | !value all | collect} ""]
  assert [== [map-get {!gen x | !value all} "i"] 7]

  # A typed output: `emit` makes a program's stdout carry values, and its reader gets them as
  # values, through typed stages too.
  def ns {!nums 5 | collect}
  assert [== [vec-len $ns] 5]
  assert [== [vec-get $ns 4] 4]
  def ms {!nums 4 maps | collect}
  assert [== [vec-len $ms] 4]
  assert [== [map-get [vec-get $ms 3] "n"] 3]
  def ds {!nums 300 | !double | collect}
  assert [== [vec-len $ds] 300]
  assert [== [vec-get $ds 299] 598]
  assert [== {!nums 3 | !double} "doubled"]
  assert [== {!nums 10 | sumvals} 45]

  # A program this vat was not granted.
  def none {!gen a | !nope}
  assert [error? $none]
  assert [error? {!gen a | !nope | collect}]

  # `&` is spawn: the Future is the Job, and awaiting it gives the pipeline's value. The output
  # went to the enclosing output.
  def bg {!gen bg | !upcase &}
  assert [== [await $bg] 0]

  # Cancel severs the pipeline's edges (cancelled); each stage ends through its edges and is
  # reaped, and awaiting the Future gives the error. `sink` never writes, so it learns at its
  # next read.
  def k {!forever | !sink &}
  sleep 0.02
  assert [cancel $k]
  assert [== [error-val [await $k]] "cancelled"]
  assert [== [cancel $k] $false]

  # A stage that never touches its stdio learns nothing from the sever, so cancel kills each stage
  # too (theSherwood/unir#35): `spin` loops, and `sink` waits on an upstream that never writes.
  def killed {!spin | !sink &}
  sleep 0.02
  assert [cancel $killed]
  assert [== [error-val [await $killed]] "cancelled"]

  # Suspend holds a pipeline under backpressure and resume releases it, with nothing lost or
  # repeated (tally checks every byte).
  def n [atom 0]
  def t [spawn {!forever | !upcase | tally $n}]
  wait-past $n 0
  assert [suspend $t]
  sleep 0.02
  def held [deref $n]
  sleep 0.05
  assert [== [deref $n] $held]
  assert [resume $t]
  wait-past $n [+ $held 1000]
  cancel $t
  assert [== [error-val [await $t]] "cancelled"]

  # A task with no pipeline acts on them at its job-control points (here, sleep).
  def c [atom 0]
  def s [spawn { while $true { swap $c [\ + $it 1]; sleep 0.001 } }]
  wait-past $c 0
  suspend $s
  sleep 0.01
  def cs [deref $c]
  sleep 0.02
  assert [== [deref $c] $cs]
  resume $s
  wait-past $c $cs
  cancel $s
  assert [== [error-val [await $s]] "cancelled"]

  # `$ctx` and `$env` reach a stage only when passed (docs/CTX_ENV.md). The root's `$env` is the
  # host's environment block; a stage's is empty unless its spawner passes one with `with-env`.
  assert [== [map-get $env "JACL_TEST_ENV"] "root"]
  with-ctx {secret "s"} {
    assert [== {!envdump JACL_TEST_ENV | collect} "ctx 0 env 0\n"]
  }
  assert [== [with-env {K v} {!envdump K JACL_TEST_ENV | collect}] "ctx 0 env 1\nK=v\n"]
  assert [== [with-env $env {!envdump JACL_TEST_ENV | collect}] "ctx 0 env 1\nJACL_TEST_ENV=root\n"]
  assert [== {!envdump K | collect} "ctx 0 env 0\n"]
  # A `spawn` inside `with-env` starts its programs with the same environment.
  def sp [with-env {K w} {spawn {!envdump K | collect}}]
  assert [== [await $sp] "ctx 0 env 1\nK=w\n"]
  # The environment crosses as a value.
  assert [== [with-env {N 7} {!envdump N | collect}] "ctx 0 env 1\nN=7\n"]
  0
}

main
