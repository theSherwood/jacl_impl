##
## pair — one of two editors on one document, each on its own machine (theSherwood/unir#62,
## docs/UNIR_SERVICES.md). Each machine runs unir's store vat; the vats replicate ref `doc` over
## TCP, and the replica (machine 1) merges what the two type at once. Run as the vat's client on
## both machines, with no output: it checks itself, and a failed check is its error value, which
## its machine reports. The harness defines `[role]`, which machine this is: 0 or 1.
##
## Machine 0 types "hello"; machine 1 waits to see it, then types " world". Machine 0 waits to
## see that, then both type at once: 0 "> " at the start, 1 "!" at the end. Both wait for the
## merge, "> hello world!", then make ref `done`, which ends replication.
##

## The payload of reply REQ's variant KIND; any other reply fails the editor.
proc ask {s, req, kind} {
  def r [service-call $s $req]
  assert [not [error? $r]]
  assert [map-has $r $kind]
  map-get $r $kind
}

## The length of version V (none: 0).
proc doc-len {s, v} {
  if [== $v $nil] { 0 } else { map-get [ask $s [map "Info" $v] "Info"] "len" }
}

## The text of version V (none: empty).
proc text {s, v} {
  if [== $v $nil] { "" } else {
    buf-string [ask $s [map "Read" [map "version" $v "at" 0 "len" [doc-len $s $v]]] "Data"]
  }
}

## Inserts STR into `doc` at AT, or at its end when AT is nil, as one commit; on a conflict (the
## other machine's typing arrived first) again on the head it lost to. The new version.
proc put {s, at, str} {
  mut head [ask $s [map "Head" "doc"] "Head"]
  mut made $nil
  while [== $made $nil] {
    def pos [if [== $at $nil] { doc-len $s $head } else { $at }]
    def edit [map "at" $pos "delete" 0 "insert" $str]
    def r [service-call $s [map "Commit" [map "name" "doc" "base" $head "edits" [vec $edit]]]]
    assert [not [error? $r]]
    if [map-has $r "Version"] { set made [map-get $r "Version"] } else { set head [map-get $r "Conflict"] }
  }
  $made
}

## Types STR a character per commit, from AT on (or each at the end, when AT is nil).
proc type {s, at, str} {
  mut i 0
  while [< $i [length $str]] {
    put $s [if [== $at $nil] { $nil } else { + $at $i }] [index $str $i]
    set i [+ $i 1]
  }
}

## Waits, following `doc`, until its text is WANT; the version that has it.
proc until-text {s, want} {
  mut h [ask $s [map "Head" "doc"] "Head"]
  while [not [== [text $s $h] $want]] {
    set h [map-get [map-get [service-event $s $true] "changes"] "to"]
  }
  $h
}

proc main {} {
  def s [service "store"]
  assert [not [error? $s]]
  ask $s [map "Follow" "doc"] "Head"
  if [== [role] 0] {
    type $s $nil "hello"
    until-text $s "hello world"
    type $s 0 "> "
  } else {
    until-text $s "hello"
    type $s $nil " world"
    type $s $nil "!"
  }
  until-text $s "> hello world!"
  ask $s [map "Commit" [map "name" "done" "base" $nil "edits" [vec]]] "Version"
  0
}

main
