# mode: concurrent
##
## shell — the JACL shell (#204; theSherwood/unir decisions 100, 117, 118): a REPL in a terminal pane.
## Run by unir's store vat in its `shell` or `session` mode, which grants it the store as `store`, a
## second session with it as `transcript`, the pane as `pane`, the notification the pane's events
## signal as `shell.n`, the Jit capability, and the programs it may run as `bin.NAME`. Waiting, it
## waits on that notification, which its jobs' writes and ends signal too (#219). Each line typed
## is a job: compiled here, by the compiler linked into
## this program's image, and run as a task in this program's own domain (`[repl-eval]`), so what one
## line defines the lines after it see. What a job outputs goes to its blocks of the transcript,
## each headed by the line (`$ctx.out`): what it prints, the values it emits, and its pipelines'
## output, typed under the schema their last program offered. A job that shows nothing else shows
## its value, and one that fails shows why. Before the first prompt the shell evaluates its profile,
## the store's document `profile` if there is one, so every line sees what the profile defines.
## Its transcript and line are session refs, which a store never journals: on a store reopened
## from its log, the next session's shell finds neither (unir decision #282.2).
##
##   LINE &     runs LINE in the background
##   jobs       lists the jobs running or stopped
##   fg [N]     waits for job N (the last, by default), resuming it if it is stopped
##   bg [N]     resumes job N in the background
##   kill [N]   ends job N
##   Ctrl-C     ends the job waited for; Ctrl-Z stops it
##   Up, Down   earlier and later lines
##   quit       ends the shell
##
## While the shell waits for a job, the pane's keys other than Ctrl-C and Ctrl-Z, and its sizes, are
## the job's input (`$ctx.in`, an atom of a vector of them, which the job empties as it takes
## them); what it leaves is typed at the prompt once it ends. A reference activated in the
## transcript runs `open NAME` as a job, NAME the reference's, which shows only what it outputs:
## the profile says what opening a name means (unir decision 106).
##

## Asserts that R, what a transcript call returned, is not an error.
proc ok {r} {
  assert [not [error? $r]]
}

## The payload of reply REQ's variant KIND; any other reply fails the program.
proc ask {s, req, kind} {
  def r [service-call $s $req]
  assert [not [error? $r]]
  assert [map-has $r $kind]
  map-get $r $kind
}

## The text of version V of a document in the store S, read 2 KiB at a time: a reply is one of
## the session's frames, which hold 4 KiB.
proc text {s, v} {
  def len [map-get [ask $s [map "Info" $v] "Info"] "len"]
  mut out ""
  mut at 0
  while [< $at $len] {
    def n [if [< [- $len $at] 2048] { [- $len $at] } else { 2048 }]
    set out [concat $out [buf-string [ask $s [map "Read" [map "version" $v "at" $at "len" $n]] "Data"]]]
    set at [+ $at $n]
  }
  $out
}

## The character a key's code stands for: printable ASCII, else "".
def printable " !\"#\x24%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
proc char-of {code} {
  if [&& [>= $code 32] [<= $code 126]] { index $printable [- $code 32] } else { "" }
}

## LINE split at its spaces.
proc words {line} {
  mut out [vec]
  mut w ""
  for [range 0 [length $line]] i {
    def c [index $line $i]
    if [== $c " "] {
      if [> [length $w] 0] { set out [vec-push $out $w] }
      set w ""
    } else {
      set w [concat $w $c]
    }
  }
  if [> [length $w] 0] { set out [vec-push $out $w] }
  $out
}

## A block of the transcript T, headed by LINE for job N, holding TEXT.
proc say {t, line, n, text} {
  def b [transcript-output $t $line $n]
  ok $b
  ok [transcript-write $t $b $text]
  ok [transcript-end $t $b]
}

## A block of the transcript T, headed by LINE for job N, holding the value V.
proc show {t, line, n, v} {
  def b [transcript-block $t $line $n $nil]
  ok $b
  ## A value the values schema cannot carry (a closure) is shown as its text.
  if [error? [transcript-push $t $b $v]] { ok [transcript-push $t $b [to-string $v]] }
  ok [transcript-end $t $b]
}

## Starts SRC as job N, LINE its command: a task whose output goes to the job's place in the
## transcript T and whose input is the pane's events while the shell waits for it. The job's
## record: its task, its place, its input, its line, whether it is stopped, and whether it is
## QUIET, showing only its output.
proc start {t, line, src, n, quiet} {
  def s [transcript-job $t $line $n]
  ok $s
  def in [atom [vec]]
  def f [with-ctx {out $s; in $in} { spawn { repl-eval $src } }]
  map "f" $f "s" $s "in" $in "line" $line "stopped" $false "quiet" $quiet
}

## TEXT as a string literal: the characters a string would read as code, escaped.
def escapes [map "\"" "\\x22" "\\" "\\x5c" "\x24" "\\x24" "[" "\\x5b" "]" "\\x5d"]
proc quoted {text} {
  mut out "\""
  for [range 0 [length $text]] i {
    def c [index $text $i]
    set out [concat $out [if [map-has $escapes $c] { [map-get $escapes $c] } else { $c }]]
  }
  concat $out "\""
}

## Gives job J (a record) the pane's event E as its input.
proc give {j, e} {
  swap [map-get $j "in"] [\ vec-push $it $e]
}

## Ends each job in JOBS (an atom of a map from number to record) whose task has finished. One
## that failed shows why; one that showed nothing else shows its value, unless it is quiet. (A
## job's error is only read here: passed on, it would end this proc with it.) The events the
## ended jobs left in their input, for the prompt.
proc reap {t, jobs} {
  mut left [vec]
  for [map-keys [deref $jobs]] n {
    def j [map-get [deref $jobs] $n]
    if [done? [map-get $j "f"]] {
      def v [await [map-get $j "f"]]
      def line [map-get $j "line"]
      if [error? $v] {
        def why [to-string [error-val $v]]
        ok [transcript-job-end [map-get $j "s"] [!= $why "cancelled"]]
        say $t $line $n [concat "error: " [concat $why "\n"]]
      } else {
        def shown [transcript-job-end [map-get $j "s"] $true]
        ok $shown
        if [&& [== $shown 0] [not [map-get $j "quiet"]]] { show $t $line $n $v }
      }
      set left [vec-concat $left [deref [map-get $j "in"]]]
      reset $jobs [map-remove [deref $jobs] $n]
    }
  }
  $left
}

## The job WORDS name (`fg 2`), or the last one when they name none; nil if there is no such job.
proc job-named {jobs, words} {
  mut found $nil
  for [map-keys [deref $jobs]] n {
    if [> [length $words] 1] {
      if [== [to-string $n] [index $words 1]] { set found $n }
    } else {
      if [|| [== $found $nil] [> $n $found]] { set found $n }
    }
  }
  $found
}

## The text `jobs` shows: a line per job of JOBS.
proc listing {jobs} {
  mut text ""
  for [map-keys [deref $jobs]] n {
    def j [map-get [deref $jobs] $n]
    def state [if [map-get $j "stopped"] { "stopped" } else { "running" }]
    set text [concat $text [concat "[" [concat [to-string $n] [concat "] " [concat $state [concat "  " [concat [map-get $j "line"] "\n"]]]]]]]
  }
  $text
}

proc main {} {
  def s [service "store"]
  assert [not [error? $s]]
  ## The writer's own session, opened before the pane: the vat answers none of this program's
  ## sessions until it has connected them all, in order.
  def t [transcript "transcript" "~shell/transcript" "~shell/line"]
  assert [not [error? $t]]
  def p [service "pane" "shell.n"]
  assert [not [error? $p]]
  assert [== [service-send $p [map "show" [map "transcript" "~shell/transcript" "line" "~shell/line"]]] $nil]
  ## The profile, evaluated here, before the first prompt: what it defines every line sees, and
  ## what fails in it shows as a block.
  def profile [ask $s [map "Head" "profile"] "Head"]
  if [!= $profile $nil] {
    def v [repl-eval [text $s $profile]]
    if [error? $v] { say $t "profile" 0 [concat "error: " [concat [to-string [error-val $v]] "\n"]] }
  }
  def jobs [atom [map]]
  mut last 0
  ## The job waited for, while there is one: then keys control it rather than edit the line.
  mut fg $nil
  mut line ""
  mut history [vec]
  mut back 0
  ## Keys typed while the shell waits for a job, kept for the prompt.
  mut ahead [vec]
  mut go $true
  ## Whether the last pass found nothing to do: then this pass's first read waits.
  mut idle $false
  ## The named keys come as their names; the rest as maps (`Char`, `Ctrl`, `Alt`).
  def named [map "Enter" 1 "Tab" 1 "Backspace" 1 "Delete" 1 "Escape" 1 "Up" 1 "Down" 1 "Right" 1 "Left" 1 "Home" 1 "End" 1 "PageUp" 1 "PageDown" 1]
  def shell-commands [map "jobs" 1 "fg" 1 "bg" 1 "kill" 1]
  ok [transcript-line $t "\x24 "]
  while $go {
    ## What an ended job left was typed after what waits already.
    set ahead [vec-concat $ahead [reap $t $jobs]]
    if [&& [!= $fg $nil] [not [map-has [deref $jobs] $fg]]] {
      set fg $nil
      ok [transcript-line $t [concat "\x24 " $line]]
    }
    ok [transcript-flush $t]
    ## Every event waiting, then the line drawn once: a burst of keys, or a paste, is one commit.
    mut any $false
    mut more $true
    while $more {
      mut e $nil
      if [&& [== $fg $nil] [> [length $ahead] 0]] {
        set e [index $ahead 0]
        set ahead [vec-slice $ahead 1 [length $ahead]]
      } else {
        ## Waiting, for the pane's next event, or until a job writes or ends, so the next pass
        ## commits what it wrote or reaps it (#219). A second at most: a pass a second, idle.
        set e [service-event $p [if $idle { 1 } else { $false }]]
        set idle $false
      }
      if [== $e $nil] { set more $false } else {
        set any $true
        if [map-has $e "keys"] {
          def k [map-get $e "keys"]
          def control [if [map-has $named $k] { $false } else { [map-has $k "Ctrl"] }]
          if [!= $fg $nil] {
            ## Waiting for a job: Ctrl-C ends it; Ctrl-Z stops it and returns to the prompt.
            if $control {
              def j [map-get [deref $jobs] $fg]
              if [== [map-get $k "Ctrl"] 99] { cancel [map-get $j "f"] }
              if [== [map-get $k "Ctrl"] 122] {
                suspend [map-get $j "f"]
                reset $jobs [map-set [deref $jobs] $fg [map-set $j "stopped" $true]]
                set fg $nil
              }
            } else {
              give [map-get [deref $jobs] $fg] $e
            }
          } else {
            if [map-has $named $k] {
              if [&& [== $k "Backspace"] [> [length $line] 0]] {
                set line [slice $line 0 [- [length $line] 1]]
              }
              if [&& [== $k "Up"] [< $back [length $history]]] {
                set back [+ $back 1]
                set line [index $history [- [length $history] $back]]
              }
              if [&& [== $k "Down"] [> $back 0]] {
                set back [- $back 1]
                set line [if [== $back 0] { "" } else { [index $history [- [length $history] $back]] }]
              }
              if [== $k "Enter"] {
                def w [words $line]
                def cmd [if [> [length $w] 0] { [index $w 0] } else { "" }]
                if [> [length $line] 0] { set history [vec-push $history $line] }
                set back 0
                if [== $line "quit"] { set go $false } else {
                  if [== $cmd "jobs"] { say $t $line 0 [listing $jobs] }
                  if [|| [== $cmd "fg"] [|| [== $cmd "bg"] [== $cmd "kill"]]] {
                    def n [job-named $jobs $w]
                    if [== $n $nil] { say $t $line 0 "error: no such job\n" } else {
                      def j [map-get [deref $jobs] $n]
                      if [== $cmd "kill"] { cancel [map-get $j "f"] } else {
                        if [map-get $j "stopped"] {
                          resume [map-get $j "f"]
                          reset $jobs [map-set [deref $jobs] $n [map-set $j "stopped" $false]]
                        }
                        if [== $cmd "fg"] { set fg $n }
                      }
                    }
                  }
                  if [&& [> [length $w] 0] [not [map-has $shell-commands $cmd]]] {
                    set last [+ $last 1]
                    ## A line ending in `&` runs in the background; any other is waited for.
                    def bg [== [index $line [- [length $line] 1]] "&"]
                    def src [if $bg { [slice $line 0 [- [length $line] 1]] } else { $line }]
                    reset $jobs [map-set [deref $jobs] $last [start $t $src $src $last $false]]
                    if [not $bg] { set fg $last }
                  }
                }
                set line ""
              }
            } else {
              if [map-has $k "Char"] { set line [concat $line [char-of [map-get $k "Char"]]] }
            }
          }
        } else {
          if [&& [map-has $e "lifecycle"] [== [map-get $e "lifecycle"] "Close"]] { set go $false }
          ## A size is the job's waited for, as its keys are.
          if [&& [map-has $e "geometry"] [!= $fg $nil]] {
            give [map-get [deref $jobs] $fg] $e
          }
          ## A reference activated: `open NAME`, a job of its own beside any other.
          if [&& [map-has $e "acts"] [map-has [map-get $e "acts"] "Activate"]] {
            def pick [map-get [map-get $e "acts"] "Activate"]
            def name [transcript-pick $t [map-get $pick "block"] [map-get $pick "value"]]
            if [&& [!= $name $nil] [not [error? $name]]] {
              set last [+ $last 1]
              def src [concat "open " [quoted $name]]
              reset $jobs [map-set [deref $jobs] $last [start $t [concat "open " $name] $src $last $true]]
            }
          }
        }
      }
    }
    if $any {
      ok [transcript-line $t [if [== $fg $nil] { [concat "\x24 " $line] } else { "" }]]
    }
    set idle [not $any]
  }
  for [map-keys [deref $jobs]] n { cancel [map-get [map-get [deref $jobs] $n] "f"] }
  ask $s [map "Commit" [map "name" "~done" "base" $nil "edits" [vec]]] "Version"
  0
}

main
