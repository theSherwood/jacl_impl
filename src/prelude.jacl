# JACL Prelude - Macro definitions loaded before user code
# This file is converted to a C header (prelude_source.h) by build.sh

# Lambda shorthand: [\ + $it 1] expands to proc {^it} { + $it 1 }
defmacro \ {head ..rest} {
  def body [make-syntax "command" $head $rest]
  def blk [make-syntax "block" [vec $body]]
  def pn [make-syntax "lit-string-caret" "it"]
  def params [make-syntax "command" $pn [vec]]
  def nm [make-syntax "lit-string" ""]
  [make-syntax "command" [make-syntax "lit-string" "proc"] [vec $nm $params $blk]]
}

# NOTE: Binding operators (=, :, ::) and the pipe operator (|) used to be
# defined here as macros, but the parser already desugars them at parse
# time (typed bindings like `i64 x = 5` go through a dedicated rule and
# would be MIScompiled if these macros expanded — `lhs` ends up wrapped
# in a stray command). Removed 2026-05-18 along with the macro fast-path
# fix that started consuming the auto-generated prelude name list — any
# entry here triggers expansion at every user call site, so a macro that
# can't safely fire must not appear in the file.

# Logical AND: [and a b] expands to [&& a b] for short-circuit behavior
defmacro and {a b} {
  syntax-quote [&& ~a ~b]
}

# Logical OR: [or a b] expands to [|| a b] for short-circuit behavior
defmacro or {a b} {
  syntax-quote [|| ~a ~b]
}

# Logical NOT: [not a] expands to [~ a]
# Uses make-syntax because ~ is the unquote operator in syntax-quote
defmacro not {a} {
  def head [make-syntax "lit-string" "~"]
  [make-syntax "command" $head [vec $a]]
}

# incr name — increment a mutable binding in place: [incr i] == [set i [+ $i 1]]
# Sugar for the common counted-loop step expression. Named `incr` rather
# than `inc` since `inc` is widely used as a user-defined proc name across
# the test suite; the prelude must not shadow that.
#
# The macro takes a bare name (lit-string syntax) for the set target, then
# builds a fresh var-ref to that same name for the `+` operand — `syntax-
# datum` pulls the string out of the lit-string syntax node, and
# `make-syntax "var-ref"` rebuilds it as a var-ref.
defmacro incr {x} {
  def name [syntax-datum $x]
  def vref [make-syntax "var-ref" $name]
  syntax-quote [set ~x [+ ~vref 1]]
}

# timeout n body — race body against a sleeping branch that errors after n
# seconds. Returns body's value if it completes within the deadline,
# otherwise an error value with payload "timeout".  Requires a suspending
# context (the implicit one created by spawn/parallel/race/proc with
# suspending callees).
defmacro timeout {n body} {
  syntax-quote [race ~body { sleep ~n; error "timeout" }]
}
