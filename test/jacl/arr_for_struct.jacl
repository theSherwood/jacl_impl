# expect: 1
# expect: 3
# expect: 4
# expect: ok
# Phase 2: for-loop over a struct-element arr ([Arr Point]). The binding
# narrows to the struct type (inline-width local via OP_INLINE_TO_LOCAL),
# so field access $p->x works in the body.
struct Point [ i32 x, i32 y ]
proc main [] [
  def pts [[Arr Point] [Point x 1 y 2] [Point x 3 y 4]]
  for $pts p [ print $p->x ]         # 1 3

  # accumulate a field across the struct elements
  mut i32 xsum 0
  for $pts q [ set xsum [+ $xsum $q->x] ]
  print $xsum                        # 1 + 3 = 4

  for $pts r [ assert-type $r Point ]
  print "ok"
]
main
