# expect: 100
# expect: 200
# expect: 300
# expect: 600
# expect: 60
# expect: ok
# Wide-scalar (i64/u64/f64) for-binding narrowing — works in both plain and
# suspending (SM) procs. The binding narrows to the wide scalar; non-SM loops
# store it in a typed local, SM loops store it boxed in a state field and
# unbox on read. Regression for the original segfault (raw wide bits in a
# GC-traced state field).
proc sum-arr {} {
  def fut [spawn { 0 }]          # makes this an SM proc
  def a [[Arr i64] 10 20 30]
  mut i64 total 0
  for $a n { set total [+ $total $n] }   # wide binding in a state field
  await $fut
  $total
}
proc main {} {
  def a [[Arr i64] 100 200 300]
  for $a x { print $x }          # 100 200 300 (narrowed wide, correct values)

  mut i64 total 0
  for $a y { set total [+ $total $y] }   # typed i64 accumulation (non-SM)
  print $total                   # 600

  for $a z { assert-type $z i64 }        # binding statically narrows to i64

  print [sum-arr]                # 60 (wide for-binding across a suspension)
  print "ok"
}
main
