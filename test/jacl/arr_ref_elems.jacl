# expect: x
# expect: 2
# expect: 3
# expect: z
# expect: y
# expect: 2
# expect: w
# expect: 2
# expect: a
# expect: b
# expect: 5000000000
# expect: ok
# Ref-element [Arr T] (`arr` is shorthand for [Arr dyn]). Ref elements (str,
# dyn) use the DYN arr rep — tagged traced slots, no flat-bytes rep win — and
# the element type lives statically as TYPE_ARR + stamp: constructor element
# checks, arr-get/arr-pop narrowing, push/set expected-type, for-binding
# narrowing. Value-type elements ([Arr i64], [Arr Pt]) keep the flat rep.
proc main {} {
  # 1. [Arr str]: ctor + get narrowing + push/pop/set/len
  def sa [[Arr str] "x" "y"]
  assert-type [arr-get $sa 0] str
  print [arr-get $sa 0]
  print [arr-len $sa]
  print [arr-push $sa "z"]
  print [arr-pop $sa]
  arr-set $sa 0 "w"
  print [arr-get $sa 1]
  print [arr-len $sa]
  print [arr-get $sa 0]

  # 2. [Arr dyn] IS the plain arr
  def da [[Arr dyn] 1 "two"]
  print [arr-len $da]

  # 3. def propagation + annotation: binding keeps the stamp; for narrows
  def [Arr str] aa [[Arr str] "a" "b"]
  for $aa s {
    assert-type $s str
    print $s
  }

  # 4. dyn slots never autobox: a wide i64 must be boxed EXPLICITLY to
  # live in a dyn arr (an unboxed wide push is a compile error — see
  # arr_wide_dyn_error.jacl). The box round-trips through the dyn slot.
  def i64 m 1000000
  def i64 big [* $m 5000]
  def wa [arr]
  arr-push $wa [box $big]
  print [deref [arr-get $wa 0]]

  print "ok"
}
main
