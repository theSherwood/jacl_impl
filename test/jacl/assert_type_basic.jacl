# expect: ok
# `assert-type` is a compile-time static check: the typer compares the
# expression's inferred type to the second arg and errors on mismatch.
# No runtime evaluation — the expression is NOT compiled (no side
# effects, no operand-stack cost).

proc typed-add {i64 a, i64 b} i64 { + $a $b }
proc shout {str s} str { concat $s "!" }

proc main {} {
  def i32 thirty-two 32
  def i64 sixty-four 64
  def f64 pi 3.14
  def str s "hi"

  assert-type $thirty-two i32
  assert-type $sixty-four i64
  assert-type $pi f64
  assert-type $s str
  assert-type [typed-add 1 2] i64
  assert-type [shout "hello"] str
  # `[+ 1 2]` is all literals, so it is dyn (#112) — and now that the typer's verdict is
  # actually read (#117), the static answer is the one that runs. This line asserted `i32`
  # when it was describing the value's *representation* rather than its type (jacl #118).
  assert-type [+ 1 2] dyn
  assert-type [vec 1 2 3] vec
  assert-type [== 1 1] bool
  print "ok"
}
main
