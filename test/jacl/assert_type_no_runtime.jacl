# expect: only-this
# assert-type does NOT evaluate its expression at runtime. If it did,
# the embedded `print "side-effect"` would fire and the body of
# `compute` would run too.
proc i32 compute {} {
  print "side-effect"
  42
}
proc main {} {
  assert-type [compute] i32
  print "only-this"
}
main
