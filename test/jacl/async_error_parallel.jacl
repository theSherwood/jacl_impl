# expect: true
# expect: par-err
# expect: 99
# parallel error in async context — pre-await variable used in parallel body
proc main [] {
  def x 42
  def r [parallel { [+ $x 0] } { error "par-err" }]
  print [error? $r]
  print [error-val $r]
  def f [spawn { 99 }]
  def v [await $f]
  print $v
}
main
