# mode: concurrent
# expect: true
# expect: task failure
# spawn a task that calls [error "msg"], await it, verify error? is true and error-val returns the message
proc fail {} {
  error "task failure"
}
proc main {} {
  def f [spawn { fail }]
  def result [await $f]
  print [error? $result]
  print [error-val $result]
}
main
