# expect: a:0->1
# expect: b:0->1
# expect: a:1->2
# expect: b:1->2
# Multiple keyed watchers all fire on each commit in registration order.
def counter [atom 0]
la = proc {old, new} { print "a:$old->$new" }
lb = proc {old, new} { print "b:$old->$new" }
watch $counter "a" $la
watch $counter "b" $lb
reset $counter 1
swap $counter [\ $+ $it 1]
