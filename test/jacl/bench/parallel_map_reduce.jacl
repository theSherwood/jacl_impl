# Bench scenario: 4-way parallel sum-reduce.
#
# Split the range 0..10000 into 4 contiguous chunks of 2500 and sum
# each in its own parallel branch, then combine the partial sums.
# Targets:
#   - real cross-worker dispatch (each `parallel { ... }` body lands on
#     a separate worker if the runtime has idle ones)
#   - completion / join continuation under low contention
#   - bytecode running concurrently on multiple VMs at once
#
# `spawn_chain` is intentionally serial — this is the parallelism
# regression guard. With 2 workers (the harness default) two branches
# run concurrently and two queue; with 4+ workers all four overlap.
#
# Output: sum 0..9999 = 49995000.

proc sum-range {lo hi} {
  mut s 0
  mut i $lo
  while [< $i $hi] {
    set s [+ $s $i]
    set i [+ $i 1]
  }
  $s
}

def r [parallel { sum-range 0 2500 } { sum-range 2500 5000 } { sum-range 5000 7500 } { sum-range 7500 10000 }]

mut total 0
set total [+ $total [vec-get $r 0]]
set total [+ $total [vec-get $r 1]]
set total [+ $total [vec-get $r 2]]
set total [+ $total [vec-get $r 3]]
print $total
