# expect-error: out of bounds for dimension size 3
# Dynamic-index arrow chains on nested bufs are bounds-checked at
# runtime via OP_PTR_OFFSET_CHECKED. Literal indices are validated at
# compile time (see buf_nested_oob.jacl); this fixture covers the
# runtime path for the dynamic case.

proc main {} {
  def [Buf 2 [Buf 3 [Buf 4 i32]]] cube
  mut j 5
  print $cube->0->$j->0
}
main
