# expect: 170
# expect: 170
# expect: 170
# expect: 4
# expect: 102
# expect: 102
# expect: 102
# expect: 102
# expect: 12000000007
# expect: 10999999999
# expect: -9000000000
# expect: 18446744073709551614
# expect: 1
# expect: 4294967295
# expect: 4294967294
# expect: -2147483647
# expect: true
# Real C extern calls operating on JACL buffers. Verifies that
# `[addr $buf]` produces a stable pointer the C side can dereference,
# that the GC doesn't move buffer-local bytes during the call, and
# that the [Buf N T] -> [Ptr T] decay at call boundaries matches the
# C ABI, and that a scalar crosses in its declared width: an i64 or u64
# keeps its high half, a u32 or u64 at the top of its range stays
# unsigned, and an argument's arithmetic errors on overflow as a raw
# binding's of its type does (#290). The catalog functions live in
# runtime/harness/extern_catalog.c; fixture names are kept <=7 bytes so
# they encode as inline strings without the intern table. See
# BUFFER_DESIGN.md Tier 2 (test-harness native-fn registration).

extern t_sumi {[Ptr i32] buf i32 len} i32
extern t_fill {[Ptr u8] buf i32 len i32 byte} i32
extern t_xor {[Ptr u8] dst [Ptr u8] src i32 len} i32
extern t_mad {i64 a i64 b i64 c} i64
extern t_sum64 {[Ptr i64] buf i64 len} i64
extern t_not64 {u64 x} u64
extern t_not32 {u32 x} u32
extern t_neg {i32 x} i32

proc sum {} {
  # Callee reads back the i32 elements the caller stored. Decayed
  # pointer is the actual byte address of the caller's frame slot.
  def [Buf 3 i32] xs [[Buf 3 i32] 6 7 8]
  print [t_sumi $xs 3]
}
[sum]

proc fill {} {
  # Callee writes through the decayed pointer; caller observes the
  # mutation by reading the buf back through buf-get.
  def [Buf 4 u8] scratch
  print [t_fill $scratch 4 0xaa]
  print [buf-get $scratch 0]
  print [buf-get $scratch 1]
  print [buf-get $scratch 2]
  print [buf-get $scratch 3]
}
[fill]

proc xor {} {
  # Two buf args decay independently; both pointer values reach C
  # alongside one another. dst gets dst ^ src in-place.
  def [Buf 4 u8] dst [[Buf 4 u8] 0xaa 0xaa 0xaa 0xaa]
  def [Buf 4 u8] src [[Buf 4 u8] 0xcc 0xcc 0xcc 0xcc]
  print [t_xor $dst $src 4]
  print [buf-get $dst 0]
  print [buf-get $dst 1]
  print [buf-get $dst 2]
  print [buf-get $dst 3]
}
[xor]

proc wide {} {
  # i64 params and result: 3000000000 * 4 + 7 needs 34 bits, and so
  # does a negative result's high half.
  print [t_mad 3000000000 4 7]
  # A pointer into an i64 buffer beside an i64 length; the elements
  # are past i32 too.
  def [Buf 3 i64] xs [[Buf 3 i64] 5000000000 6000000000 -1]
  print [t_sum64 $xs 3]
  print [t_mad -3000000000 3 0]
  # A u64 result past INT64_MAX is that number, not a negative one, and
  # it goes back in as itself.
  def big [t_not64 1]
  print $big
  print [t_not64 [t_not64 1]]
  # A u32 at the top of its range, out and back in.
  print [t_not32 0]
  print [t_not32 1]
}
[wide]

proc neg_past {} {
  # An i32 argument is computed as a raw i32 binding's tree is, so
  # INT32_MAX + 1 is an error before the call (INVARIANTS.md V5), not
  # INT32_MIN handed to C.
  def i32 big 2147483647
  [t_neg [+ $big 1]]
}
print [t_neg 2147483647]
print [error? [neg_past]]
