# Real C extern calls operating on JACL buffers. Verifies that
# `[addr $buf]` produces a stable pointer the C side can dereference,
# that the GC doesn't move buffer-local bytes during the call, and
# that the [Buf N T] -> [Ptr T] decay at call boundaries matches the
# C ABI. The catalog functions live in test_jacl_harness.c
# (harness_native_t_*); fixture names are kept <=7 bytes so they encode
# as inline strings without the intern table. See BUFFER_DESIGN.md
# Tier 2 (test-harness native-fn registration).

extern i32 t_sumi {[Ptr i32] buf i32 len}
extern i32 t_fill {[Ptr u8] buf i32 len i32 byte}
extern i32 t_xor  {[Ptr u8] dst [Ptr u8] src i32 len}

proc sum {} {
  # Callee reads back the i32 elements the caller stored. Decayed
  # pointer is the actual byte address of the caller's frame slot.
  def [Buf 3 i32] xs [[Buf 3 i32] 6 7 8]
  print [t_sumi $xs 3]
}
[sum]

proc fill {} {
  # Callee writes through the decayed pointer; caller observes the
  # mutation by reading the buf back through buf-get.
  def [Buf 4 u8] scratch
  print [t_fill $scratch 4 0xaa]
  print [buf-get $scratch 0]
  print [buf-get $scratch 1]
  print [buf-get $scratch 2]
  print [buf-get $scratch 3]
}
[fill]

proc xor {} {
  # Two buf args decay independently; both pointer values reach C
  # alongside one another. dst gets dst ^ src in-place.
  def [Buf 4 u8] dst [[Buf 4 u8] 0xaa 0xaa 0xaa 0xaa]
  def [Buf 4 u8] src [[Buf 4 u8] 0xcc 0xcc 0xcc 0xcc]
  print [t_xor $dst $src 4]
  print [buf-get $dst 0]
  print [buf-get $dst 1]
  print [buf-get $dst 2]
  print [buf-get $dst 3]
}
[xor]
