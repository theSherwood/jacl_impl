# expect: 127
# expect: 69
# expect: 76
# expect: 70
# expect: 1024
# expect: 2048
# expect: 0
# expect: 0
# Literal init via [[Buf N T] v0 v1 ...] constructor (M2.6).
# Exact fill writes all N slots; partial fill leaves the rest zero.

# Exact fill: 4 ELF magic bytes (0x7f, 0x45='E', 0x4c='L', 0x46='F').
def [Buf 4 u8] elf_magic [[Buf 4 u8] 0x7f 0x45 0x4c 0x46]
print [buf-get $elf_magic 0]
print [buf-get $elf_magic 1]
print [buf-get $elf_magic 2]
print [buf-get $elf_magic 3]

# Partial fill: first two i32 slots are 1024 and 2048; rest zero-init.
def [Buf 8 i32] header [[Buf 8 i32] 1024 2048]
print [buf-get $header 0]
print [buf-get $header 1]
print [buf-get $header 7]
print [buf-get $header 5]
