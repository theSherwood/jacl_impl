# expect: 2
# expect: 0
# expect: 0
# Phase 5b: [Buf N1 [Buf N2 [Buf N3 T]]] -- depth-3 buf declaration
# via chained TYPE_SHAPE_BUF entries. Declaration types and compiles;
# [buf-len] returns outer N1; [addr $cube->[0]] yields a pointer at
# the flat base, and ptr-offset walks the flat layout for 3-D access.
# Arrow chains beyond depth-2 ($cube->i->j->k) are not wired up yet --
# manual pointer arithmetic is the workaround.
proc main {} {
  def [Buf 2 [Buf 3 [Buf 4 i32]]] cube
  print [buf-len $cube]
  def [Ptr i32] p [addr $cube->0]
  # cube is 2 * 3 * 4 = 24 i32s, zero-initialized. Read first element.
  print [ptr-deref $p]
  # cube[0][1][2] = flat index 1 * 4 + 2 = 6
  print [ptr-deref [ptr-offset $p 6]]
}
main
