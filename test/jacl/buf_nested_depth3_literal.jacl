# Depth-3+ literal init for [Buf N1 [Buf N2 [Buf N3 T]]]. The outer
# constructor takes up to N1 inner ctors; each inner ctor is itself a
# [[Buf N2 [Buf N3 T]] ...] constructor, recursing all the way to the
# leaf scalar level. Partial fill is allowed at every level (rest stays
# zero). Closes the last open buffer item in BUFFER_DESIGN.md "Tier 1".

proc full [] [
  def [Buf 2 [Buf 3 [Buf 4 i32]]] cube [[Buf 2 [Buf 3 [Buf 4 i32]]] [[Buf 3 [Buf 4 i32]] [[Buf 4 i32] 1 2 3 4] [[Buf 4 i32] 5 6 7 8] [[Buf 4 i32] 9 10 11 12]] [[Buf 3 [Buf 4 i32]] [[Buf 4 i32] 13 14 15 16] [[Buf 4 i32] 17 18 19 20] [[Buf 4 i32] 21 22 23 24]]]
  print $cube->0->0->0
  print $cube->0->1->3
  print $cube->1->0->3
  print $cube->1->2->3
]
full

proc partial [] [
  def [Buf 2 [Buf 3 [Buf 4 i32]]] sparse [[Buf 2 [Buf 3 [Buf 4 i32]]] [[Buf 3 [Buf 4 i32]] [[Buf 4 i32] 100 200]]]
  print $sparse->0->0->2
  print $sparse->0->1->0
  print $sparse->0->0->0
  print $sparse->0->0->1
  print [buf-len $sparse]
]
partial

proc good_u8 [] [
  def [Buf 2 [Buf 2 [Buf 2 u8]]] bytes [[Buf 2 [Buf 2 [Buf 2 u8]]] [[Buf 2 [Buf 2 u8]] [[Buf 2 u8] 0x0f 0x10]]]
  print $bytes->0->0->1
  print $bytes->1->1->1
]
good_u8
