# expect: 1
# expect: 2
# expect: 3
# expect: 4
# expect: 5
# expect: 6
# expect: 7
# expect: 8
# expect: 0
# expect: 0
# Depth-2 struct-leaf literal init: `[Buf N [Buf M Struct]]` filled with
# a nested constructor. Before Step 3 of RECURSIVE_LAYOUT_REFACTOR.md the
# depth-2 nested-init path only emitted scalar (OP_BUF_USET_LOCAL) stores,
# so a struct leaf hit "unsupported element type". Now the init routes
# through the descriptor-driven walker (OP_BUF_STORE_OFF), which stores
# the struct's inline bytes at the flat byte offset row*M*sizeof + col*sizeof.

struct Point {i32 x, i32 y}
proc main {} {
  def [Buf 2 [Buf 2 Point]] grid [[Buf 2 [Buf 2 Point]] [[Buf 2 Point] [Point 1 2] [Point 3 4]] [[Buf 2 Point] [Point 5 6] [Point 7 8]]]
  print $grid->0->0->x
  print $grid->0->0->y
  print $grid->0->1->x
  print $grid->0->1->y
  print $grid->1->0->x
  print $grid->1->0->y
  print $grid->1->1->x
  print $grid->1->1->y

  # A partially-filled grid leaves the rest zero.
  def [Buf 2 [Buf 2 Point]] partial [[Buf 2 [Buf 2 Point]] [[Buf 2 Point] [Point 9 9]]]
  print $partial->1->1->x
  print $partial->0->1->y
}
[main]
