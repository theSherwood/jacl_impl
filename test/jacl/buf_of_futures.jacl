# expect: 7
# expect: 11
# Phase 5 compose case: [Buf N [Future T]] -- buf of futures. Each slot
# holds a tagged JaclVal carrying a [Future T]. Storage path same as
# M4.4 ref-elem; new piece is [Future T] recognized as an inner buf
# element via TYPE_SHAPE_FUTURE in the registry.
proc main {} {
  def [Buf 2 [Future i32]] futs
  def [Future i32] f0 [spawn { 7 }]
  def [Future i32] f1 [spawn { 11 }]
  buf-set $futs 0 $f0
  buf-set $futs 1 $f1

  # buf-get narrows to [Future i32]; await yields i32.
  def [Future i32] g0 [buf-get $futs 0]
  print [await $g0]
  def [Future i32] g1 [buf-get $futs 1]
  print [await $g1]
}
main
