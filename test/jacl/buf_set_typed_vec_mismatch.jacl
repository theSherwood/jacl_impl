# expect-error: buf-set value is a typed-vec with a different element type than the buf's [Vec T]
# [Buf N [Vec i64]] rejects a [Vec str] value: both are typed-vec but
# their inner T differs. Without this typer check, the wrong-typed value
# would be stored and downstream vec-get would interpret bytes as the
# wrong scalar.
proc main {} {
  def [Buf 3 [Vec i64]] xs
  def bad_v [[Vec str] "a" "b"]
  [buf-set $xs 0 $bad_v]
}
main
