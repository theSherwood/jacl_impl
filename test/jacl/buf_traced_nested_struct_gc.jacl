# expect: 30
# expect: 31
# expect: 32
# expect: 33
# expect: 500
# GC stress for a [Buf N dyn] field inside a NESTED struct field. The
# four stored vecs are built inline (no local binding) so their ONLY
# root is the buf slot embedded in the nested `bag` struct. Before the
# recursive layout descriptor (RECURSIVE_LAYOUT_REFACTOR.md Step 2), the
# outer struct's slot_ref_bitmap was computed by a loop that skipped
# sub-struct fields, so these slots were marked raw and the GC collected
# the vecs out from under us. Now the descriptor unions the sub-struct's
# ref map at the field offset, so the stack-inline marker traces them.

struct Inner { i32 n, [Buf 4 dyn] items }
struct Outer { i32 tag, Inner bag }

proc main {} {
  def o [Outer 1 [Inner 2]]
  set $o->bag->items->0 [vec 30 0 0]
  set $o->bag->items->1 [vec 31 0 0]
  set $o->bag->items->2 [vec 32 0 0]
  set $o->bag->items->3 [vec 33 0 0]

  # Heavy heap churn to force GC cycles. The junk vecs are unrooted the
  # instant the next iteration overwrites the binding.
  mut i 0
  while [< $i 500] {
    def junk [vec $i $i $i $i $i $i]
    set i [+ $i 1]
  }

  def a $o->bag->items->0
  def b $o->bag->items->1
  def c $o->bag->items->2
  def d $o->bag->items->3
  print [vec-get $a 0]
  print [vec-get $b 0]
  print [vec-get $c 0]
  print [vec-get $d 0]
  print $i
}
[main]
