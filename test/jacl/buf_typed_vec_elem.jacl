# expect: 20
# expect: 100
# expect: nil
# expect: 30
# expect: 200
# M4.4 ext: [Buf N [Vec T]] -- typed-collection element type. Each
# slot is a tagged JaclVal pointing to a typed-vec of T. The inner T
# rides on the binding's key_struct_idx so chained vec-get narrows to
# T at compile time.
def [Buf 3 [Vec i64]] xs
def v1 [[Vec i64] 10 20 30]
buf-set $xs 0 $v1
def v2 [[Vec i64] 100 200]
buf-set $xs 1 $v2

def got [buf-get $xs 0]
print [vec-get $got 1]
def got2 [buf-get $xs 1]
print [vec-get $got2 0]
print [buf-get $xs 2]

# Chained: arrow into the buf and then vec-get on the returned typed-vec.
print [vec-get [buf-get $xs 0] 2]
print [vec-get [buf-get $xs 1] 1]
