# expect: 7
# expect: 11
# expect: 22
# M4.4 ext: [Buf N [Vec Struct]] -- typed-vec elements of value-type
# structs. The struct T's registry idx is stashed on the buf local's
# key_struct_idx; vec-get on the returned typed-vec narrows to TYPE_STRUCT
# with the right registry idx so $point->x chains type-check.
struct Point { i32 x, i32 y }
proc main {} {
  def [Buf 2 [Vec Point]] grid
  def row0 [[Vec Point] [Point 7 11] [Point 22 33]]
  [buf-set $grid 0 $row0]

  def fetched [buf-get $grid 0]
  def p0 [vec-get $fetched 0]
  print $p0->x
  print $p0->y
  def p1 [vec-get $fetched 1]
  print $p1->x
}
main
