# expect: 127
# expect: 69
# expect: 76
# expect: 70
# expect: 1024
# M5: [buf-unchecked-get] / [buf-unchecked-set] skip the runtime bounds
# check. Same shape as buf-get / buf-set; auditable name. See
# BUFFER_DESIGN.md.
def [Buf 4 u8] b
[buf-unchecked-set $b 0 0x7f]
[buf-unchecked-set $b 1 0x45]
[buf-unchecked-set $b 2 0x4c]
[buf-unchecked-set $b 3 0x46]
print [buf-unchecked-get $b 0]
print [buf-unchecked-get $b 1]
print [buf-unchecked-get $b 2]
print [buf-unchecked-get $b 3]

# i32 elements work too.
def [Buf 8 i32] w
[buf-unchecked-set $w 5 1024]
print [buf-unchecked-get $w 5]
