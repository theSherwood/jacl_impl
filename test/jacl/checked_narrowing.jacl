# expect: 5
# expect: true
# expect: true
# expect: 3
# expect: -3
# expect: true
# expect: 5000000000
# expect: true
# expect: 5
# expect: 2147483647
# expect: true
# expect: true
#
# `dyn` -> a static width is explicit (`[to T V]`) and **checked** (jacl #116). A value the
# target cannot hold is a domain error — the class `[/ 1 0]` produces — never a truncation.
# This is the one place the integer model could leak: a `dyn`, whose whole contract is that
# its width is not observable, must not become a *different* number by being stored.
# `[to "i32" 5000000000]` used to answer 705032704.

print [to "i32" 5]
print [error? [to "i32" 5000000000]]
print [error? [to "i32" [- 0 5000000000]]]

# Dropping a float's fractional part is a different operation and stays — that is what a
# float-to-int conversion means. What is refused is a magnitude the target cannot hold, which
# in C is undefined behaviour to convert rather than merely lossy.
print [to "i32" 3.9]
print [to "i32" [- 0 3.9]]
print [error? [to "i32" 1000000000000000000000.0]]

print [to "i64" 5000000000]

# A negative number is not a u64, on either crossing. Reinterpreting the bits would answer
# 18446744073709551615.
print [error? [to "u64" [- 0 1]]]
print [to "u64" 5]

# The boundary itself is inclusive; one past it is not.
print [to "i32" 2147483647]
print [error? [to "i32" 2147483648]]

# The declared-binding widening is checked the same way.
proc negu {} { def u64 x [- 0 5]  $x }
print [error? [negu]]
