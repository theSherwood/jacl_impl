# expect: 1
# expect: 1
# expect: 1
# expect: done
# Test: ctx freed on task completion — pool reuse across multiple spawns
ctx mut i32 level = 1
proc main {} {
  def f1 [spawn { $ctx->level }]
  print [await $f1]
  def f2 [spawn { $ctx->level }]
  print [await $f2]
  def f3 [spawn { $ctx->level }]
  print [await $f3]
  print done
}
main
