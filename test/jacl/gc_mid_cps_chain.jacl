# mode: concurrent
# expect: 610
# US-007: Mid-CPS-chain GC — chain of 3+ continuations where intermediate
# upvalues are the only reference to heap objects. GC must trace through
# the CPS continuation closures to find these objects.
# fib(12)=144, fib(11)=89, fib(10)=55 => step1 returns 144+89+55+233+89 = 610
proc fib {n} {
  if [<= $n 1] { [+ $n 0] } else { [+ [fib [- $n 1]] [fib [- $n 2]]] }
}
proc step1 {} {
  def a [await [spawn { [fib 12] }]]
  def b [await [spawn { [fib 11] }]]
  def c [await [spawn { [fib 10] }]]
  def d [await [spawn { [fib 13] }]]
  def e [await [spawn { [fib 11] }]]
  [+ [+ [+ $a $b] [+ $c $d]] $e]
}
proc main {} {
  def result [step1]
  print $result
}
main
