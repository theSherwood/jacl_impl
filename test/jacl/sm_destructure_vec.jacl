# mode: concurrent
# Positional vec destructuring inside SM-compiled procs.
# Regression for the bug where OP_DESTRUCTURE_VEC pushed elements as
# stack locals while body reads went through the SM state field.
#
# expect: 60
# expect: 6

proc from-parallel [] [
  def [a b c] [parallel [ 10 ] [ 20 ] [ 30 ]]
  + $a [+ $b $c]
]

proc from-vec [] [
  def fut [spawn [ 0 ]]
  def [a b c] [vec 1 2 3]
  + $a [+ $b [+ $c [await $fut]]]
]

print [from-parallel]
print [from-vec]
