# expect: 7
# expect: 11
# §4.1c regression: a struct arriving from a PROC CALL (`def v [mk 7]`),
# crossing a yield. The SM state layout only inferred struct fields from an
# annotation or a constructor head, so the call-RHS field was sized at 1
# tagged slot while OP_RETURN_WIDE delivered raw inline bytes — they landed
# in a GC-traced slot and read back as a non-struct. The layout now also
# reads the typer's stamp on the RHS.
struct Pt [ i32 x, i32 y ]
proc mk [i32 a] Pt [
  return [Pt x $a y [+ $a 4]]
]
proc g [] [Stream i32] [
  def v [mk 7]
  yield $v->x
  yield $v->y
]
proc main [] [
  for [g] n [ print $n ]
]
main
