# expect: [V3 x 3000000000 y 3000000001 z 3000000002]
# expect: 1
# §4.1c-a regression: struct construction with COMPUTED wide (i64) fields
# inside a generator body used to byte-pack TAGGED values (the culled `def
# i64 b` was stored boxed in an untyped dyn slot, so reads stayed tagged and
# fed dyn arithmetic). Printed inside the generator to observe the packing
# directly.
struct V3 { i64 x, i64 y, i64 z }
proc g {} [Stream i64] {
  def i64 b 1000000000
  print [V3 x [* $b 3] y [+ [* $b 3] 1] z [+ [* $b 3] 2]]
  yield 1
}
proc main {} {
  for [g] n { print $n }
}
main
