# expect: [[Pt x 1 y 2], [Pt x 3 y 4]]
# expect: 1
# expect: 3
# expect: ok
# Typed collect over a struct-element stream: [Stream Pt] materializes into
# a [Vec Pt] with flat struct storage (this used to be the "collect is not
# yet supported" error — typed collect is the legal path that replaced the
# forbidden auto-box).
struct Pt { i32 x, i32 y }
proc pts {} [Stream Pt] {
  yield [Pt x 1 y 2]
  yield [Pt x 3 y 4]
}
proc main {} {
  def v [collect [pts]]
  print $v
  for $v p { print $p->x }     # 1 3
  print "ok"
}
main
