# expect-error: transform over struct-element streams is not yet supported
# HOF composition over struct-element streams is gated until the multi-slot
# channel reaches the HOF pulls (NOT_IMPLEMENTED.md §4.1b).
struct Pt { i32 x, i32 y }
proc pts {} [Stream Pt] {
  yield [Pt x 1 y 2]
}
proc main {} {
  for [transform [pts] [\ $it]] q { print $q }
}
main
