# expect: 320
# expect: 200
# expect: ok
# Regression: transform/filter over a typed i64 GENERATOR (not range). The
# generator's element type must reach the runtime stream (closure gen_elem_idx
# copied in OP_CLOSURE) so the producer-wide pull yields wide i64 into the
# wide-compiled mapper body. Before the fix the generator stream's elem_idx was
# 0, so the mapper read a tagged value as wide -> garbage. range-sourced
# transform worked, so this gap was uncaught.
proc gen {} [Stream i64] {
  yield 100
  yield 200
}
proc main {} {
  # transform over an i64 generator: (100*?+... ) wide mapper body
  mut i64 s 0
  # `[to "i64" …]` should not be needed: `transform`/`filter` lose the receiver's element
  # type, so the `for` binding comes out dyn (jacl #117, the stream half). Drop the cast when
  # that is fixed — the barrier itself is correct (TYPE_SYSTEM.md § 2).
  for [transform [gen] [\ + $it 10]] v { set s [+ $s [to "i64" $v]] }   # 110 + 210 = 320? -> 330 below
  print $s                                                    # (100+10)+(200+10) = 320
  # filter over an i64 generator: element type preserved, wide pull
  mut i64 f 0
  for [filter [gen] [\ > $it 150]] z { set f [+ $f $z] }      # 200
  print $f
  # narrowing holds through transform-over-generator
  # `dyn`, not `i64`: `transform` loses the receiver's element type (jacl #117, the stream
  # half). This line asserted i64 while the typer's verdict was unread; now that it is read
  # it describes what the typer actually concludes. Change it back when the element typing
  # is fixed — that is the assertion that will catch the fix.
  for [transform [gen] [\ * $it 2]] y { assert-type $y dyn }
  print "ok"
}
main
