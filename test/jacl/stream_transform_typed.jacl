# expect: 60
# expect: ok
# transform over a typed stream produces a stream of the lambda's RETURN type.
# The typer binds the lambda's implicit $it to the source element type, infers
# the body, and uses its tail type as the output element type (a scoped case
# of anonymous-closure return inference). The body's own annotations are
# restored to it:dyn afterward so codegen is unaffected.
proc main {} {
  # i64 source, i64-returning lambda -> [Stream i64]; for-binding narrows
  mut i64 s 0
  # `[to "i64" …]` should not be needed: `transform`/`filter` lose the receiver's element
  # type, so the `for` binding comes out dyn (jacl #117, the stream half). Drop the cast when
  # that is fixed — the barrier itself is correct (TYPE_SYSTEM.md § 2).
  for [transform [range 1 4] [\ * $it 10]] x { set s [+ $s [to "i64" $x]] }   # 10+20+30 = 60
  print $s
  # `dyn`, not `i64`: `transform` loses the receiver's element type (jacl #117, the stream
  # half). This line asserted i64 while the typer's verdict was unread; now that it is read
  # it describes what the typer actually concludes. Change it back when the element typing
  # is fixed — that is the assertion that will catch the fix.
  for [transform [range 1 4] [\ * $it 10]] y { assert-type $y dyn }

  # type-changing lambda: i64 -> bool. `dyn` for the same reason as above — the mapper's
  # return type does not reach the element type either (jacl #117, the stream half).
  for [transform [range 1 4] [\ > $it 2]] b { assert-type $b dyn }

  # composed: range i64 -> (*10) i64 -> (>15) bool
  for [transform [transform [range 1 4] [\ * $it 10]] [\ > $it 15]] c {
    assert-type $c dyn
  }
  print "ok"
}
main
