# expect: 42
# expect: 99
# Test: nested struct survives after outer struct is no longer referenced.
# Extract inner struct, let outer become garbage, verify inner is still valid.
struct Point {i32 x, i32 y}
struct Line {Point start, Point end}

proc Point getpt {} {
  def ln [Line [Point 42 99] [Point 0 0]]
  $ln->start
}

proc main {} {
  def pt [getpt]
  # ln is now garbage — only pt (the inner Point) is still live
  # Allocate more to trigger GC
  def a [Point 1 1]
  def b [Point 2 2]
  def c [Point 3 3]
  def d [Line $a $b]
  def e [Line $b $c]
  print $pt->x
  print $pt->y
}
main
