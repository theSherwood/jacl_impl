# mode: concurrent

##
## tour.jacl — a survey of JACL syntax. Linked from AGENTS.md.
## Each section exercises one feature area with `assert` calls.
## A failing assert halts the VM with "assertion failed" pointing at
## the source line, so a regression in any feature shows up directly.
## See SYNTAX.md for the full reference.
##
## Tagged `# mode: concurrent` so the harness runs the full scheduler
## (required for the spawn / parallel / race section at the end).
##
## Struct-valued bindings must live inside a proc, so the body of
## this tour is wrapped in `main`.
##

struct Pt {i32 x, i32 y}

# `ctx <type> <name> = <value>` declares a field of `$ctx`, the dynamic
# context object visible everywhere. Plain `ctx` is immutable; `ctx mut`
# allows `with-ctx` overrides. Declarations live at module level.
ctx mut i32 verbosity = 0

# `defmacro` registers a compile-time rewrite. `syntax-quote [...]` is
# a templating form for AST literals; `~name` splices a captured arg's
# AST in. The macro fires at compile time and never appears at runtime.
defmacro unless {cond body} {
  syntax-quote [if ~cond {} ~body]
}

# A generator: any proc that contains `yield` is one. Each call returns
# a fresh lazy stream; the compiler lowers the body to a state machine
# that suspends/resumes across yield sites.
proc count-up {start, stop} {
  mut i $start
  while [<= $i $stop] {
    yield $i
    set i [+ $i 1]
  }
}

proc add {a, b} { + $a $b }
proc greet {name} { concat "hi " $name }
proc zero-arg {} { + 10 20 }

# Typed proc: `proc <name> {<param-type> <param>, ...} <ret> {body}`.
# Return type comes after the params block, before the body. Param
# and return types are checked at call sites and arithmetic narrows
# accordingly (no boxing, no dyn dispatch). Untyped params default
# to `dyn`.
proc typed-add {i64 a, i64 b} i64 { + $a $b }
proc shout {str s} str { concat $s "!" }

# Variadic: `..rest` in params collects trailing args into a vector.
proc sum-all {..nums} {
  mut total 0
  for $nums n { set total [+ $total $n] }
  $total
}

# A suspending proc: contains `sleep` (unconditional suspension).
# Callers don't see any async machinery — they just call it like a
# normal function and get a value back. This is the direct-style
# payoff of CPS. (`spawn`/`await` is shown explicitly further below.)
proc double-async {n} {
  sleep 0.001
  * $n 2
}

# Suspending procs compose. Two suspending calls can appear inline as
# args to the same outer call — the SM compiler spills the enclosing
# operand stack across each suspension so siblings don't trample each
# other's results.
proc sum-async {a, b} {
  + [double-async $a] [double-async $b]
}

proc main {} {
  # ----- values -----
  # Numbers, strings, booleans, vectors.
  assert [== 42 42]
  assert [== "hi" hi]
  assert $true
  assert [not $false]
  assert [== [vec 1 2 3] [vec 1 2 3]]

  # `[Vec T]` is an immutable value; `[Arr T]` is a mutable *reference*
  # array (segment-array backed). Ops mutate in place; `==` is identity.
  def nums [arr 1 2 3]            # dyn; `[[Arr i32] ...]` for flat-typed
  arr-push $nums 4
  arr-set $nums 0 10
  assert [== [arr-len $nums] 4]
  assert [== [arr-get $nums 0] 10]
  assert [== [arr-pop $nums] 4]
  def alias $nums                 # a reference — shares storage
  arr-push $alias 99
  assert [== [arr-len $nums] 4]   # mutation visible through both
  # `for` iterates an arr; over a flat-typed [Arr i32] the binding narrows
  # to i32, so typed accumulation type-checks.
  def scores [[Arr i32] 1 2 3 4]
  mut i32 total 0
  for $scores s { set total [+ $total $s] }
  assert [== $total 10]

  # ----- bindings -----
  # `def` immutable, `mut` mutable, `set` reassigns. The `=`/`:`/`::`
  # operators are command-mode sugar for these.
  def imm 7
  assert [== $imm 7]
  also = 11                       # `=` is `def` sugar
  assert [== $also 11]
  mut counter 0
  set counter 2
  assert [== $counter 2]
  reassignable : 0                # `:` is `mut` sugar
  reassignable :: 5               # `::` is `set` sugar
  assert [== $reassignable 5]

  # ----- two modes -----
  # `[]` juxtaposition: head + args (value computation).
  # `{}` command mode: bare commands and pipelines.
  assert [== [+ 1 [* 2 [+ 1 3]]] 9]
  assert [== [+ [+ 1 2] 4] 7]
  assert [== [* [+ 1 2] 2] 6]

  # ----- string interpolation -----
  # `$var` and `$[...]` (juxtaposition) both nest in "".
  def who "alice"
  def yrs 31
  assert [== "name=$who age=$yrs sum=$[+ 2 3]" "name=alice age=31 sum=5"]

  # ----- procs -----
  # Params and body are both `{}` blocks. Type-before-name everywhere.
  # Procs are defined at module level (see above).
  assert [== [add 20 30] 50]
  assert [== [greet bob] "hi bob"]
  assert [== [zero-arg] 30]

  # ----- typed procs -----
  # Typed params/return are checked at call sites; arithmetic on
  # typed locals stays unboxed.
  assert [== [typed-add 3 4] 7]
  assert [== [shout hello] "hello!"]
  # `assert-type` is a compile-time static check: the typer compares
  # the expression's inferred type to the second arg. No runtime cost,
  # no side effects (the expression itself is not evaluated).
  assert-type [typed-add 3 4] i64
  assert-type [shout hello] str

  # ----- variadic + splat -----
  # `..nums` in params collects trailing args. `..$vec` at a call site
  # spreads a collection into separate args.
  assert [== [sum-all 1 2 3 4] 10]
  def xs [vec 5 10 15]
  assert [== [sum-all ..$xs] 30]

  # ----- lambdas -----
  # `[\ body ]` is shorthand for a one-arg proc with `$it` as the param.
  def square [\ * $it $it]
  assert [== [square 10] 100]
  assert [== [collect [transform [vec 1 2 3] [\ * $it 2]]] [vec 2 4 6]]

  # ----- if / while -----
  # `if` is an expression. `while [cond] {body}`.
  assert [== [if [> 5 0] { "positive" } { "non-positive" }] "positive"]
  mut sum 0
  mut i 1
  while [<= $i 10] {
    set sum [+ $sum $i]
    set i [+ $i 1]
  }
  assert [== $sum 55]

  # ----- for -----
  # Three relevant forms: implicit `$it`, explicit binding, C-style.
  # Works on vectors, streams, and ranges.
  #
  # Explicit binding is `for COLL NAME { body }` (collection first).
  # This intentionally breaks the `def name value` / `mut name value` /
  # `set name value` shape used by binding statements: a name-first
  # form (`for n $xs`) conflicts with pipe threading, which inserts
  # the piped value as the first argument. `$xs | for n { body }` would
  # then mean `[for $xs n { body }]` — the threaded collection landing
  # in the name slot — and the only fix is to forbid that idiom. We
  # keep collection-first so `$xs | for n { body }` reads as
  # `[for $xs n { body }]` and Just Works.
  mut seen 0
  for [vec 1 2 3] { set seen [+ $seen $it] }
  assert [== $seen 6]
  mut range-sum 0
  for [range 0 3] n { set range-sum [+ $range-sum $n] }
  assert [== $range-sum 3]

  # C-style `for {init; cond; step} { body }` — Tcl-shaped, falls out
  # of the language for free: `for` taking a header-block plus a
  # body-block, the implementation inspects the header. Useful for
  # counted loops where you want a single mutable index visible in
  # both the condition and the body.
  mut product 1
  for {mut i 1; <= $i 4; incr i} { set product [* $product $i] }
  assert [== $product 24]

  # ----- streams -----
  # Lazy sequences from generators (`yield`), ranges, or `lines`.
  # `collect` materializes; `filter`/`transform` work on either.
  assert [== [collect [range-inclusive 1 5]] [vec 1 2 3 4 5]]
  assert [== [collect [transform [range-inclusive 1 5] [\ * $it 2]]] [vec 2 4 6 8 10]]
  assert [== [collect [transform [filter [range-inclusive 1 6] [\ == 0 [% $it 2]]] [\ * $it $it]]] [vec 4 16 36]]

  # ----- generators -----
  # `count-up` (defined above) is a generator: each call returns a
  # fresh stream that suspends at each `yield`. Streams compose with
  # `transform` / `filter` / `take` like any other stream source.
  assert [== [collect [count-up 1 5]] [vec 1 2 3 4 5]]
  assert [== [collect [take [count-up 1 100] 3]] [vec 1 2 3]]

  # ----- destructuring -----
  # Positional `[]` for vectors; named `{}` for structs/maps;
  # `_` wildcard; `..rest` for trailing remainder.
  def [a b c] [vec 1 2 3]
  assert [&& [== $a 1] [&& [== $b 2] [== $c 3]]]
  def p [Pt x 10 y 20]
  def {x, y} $p
  assert [&& [== $x 10] [== $y 20]]
  def [head ..tail] [vec first second third]
  assert [== $head first]
  assert [== $tail [vec second third]]

  # ----- structs -----
  # `struct Name {type field, ...}` at module level. Constructor
  # `[Name vals...]`. Field access via `->`.
  def pt [Pt x 3 y 4]
  assert [== $pt->x 3]
  assert [== $pt->y 4]

  # ----- maps -----
  # `[map "k" v "k2" v2 ...]`. `map-get` reads; `->` is sugar for
  # string keys.
  def m [map a 1 b 2]
  assert [== [map-get $m a] 1]
  def cfg [map port 42]
  assert [== $cfg->port 42]

  # ----- typed collections -----
  # `[Vec T]` / `[Map V]` parameterize element / value type. The typed
  # binding requires the typed constructor (`[[Vec i32] ...]`), and the
  # compiler checks element types at push/set sites. Untyped `[vec ...]`
  # / `[map ...]` still work for dyn-everything use.
  def [Vec i32] typed-nums [[Vec i32] 10 20 30]
  assert [== [vec-get $typed-nums 1] 20]
  def [Map Pt] coords [[Map Pt] origin [Pt x 0 y 0] right [Pt x 1 y 0]]
  assert [== [map-get $coords right]->x 1]

  # ----- mutable state -----
  # `box` is thread-local; `atom` is CAS-shared. `reset` stores;
  # `swap` applies a fn. `deref` reads.
  def cell [box 0]
  assert [== [deref $cell] 0]
  reset $cell 1
  assert [== [deref $cell] 1]
  swap $cell [\ + $it 5]
  assert [== [deref $cell] 6]

  # ----- atom watchers -----
  # `watch` registers a keyed listener that fires on every reset/swap
  # with (old, new) in the writing thread.
  def witness [box 0]
  def counter [atom 0]
  tap = proc {old, new} { reset $witness $new }
  watch $counter tap $tap
  reset $counter 7
  assert [== [deref $witness] 7]
  swap $counter [\ + $it 5]
  assert [== [deref $witness] 12]

  # ----- errors -----
  # `try {body} name {handler}`. Errors are values; pipes short-circuit.
  # `assert` halts the VM, but `error` produces an error VALUE that
  # propagates through pipes and can be caught.
  assert [== [try { error bad } e { concat "caught: " [error-val $e] }] "caught: bad"]
  assert [error? [error boom]]

  # ----- $ctx (dynamic context) -----
  # `$ctx` is the dynamic context object; fields declared with `ctx`
  # at module level are visible everywhere. `with-ctx {field val ...}
  # { body }` overrides for the dynamic extent of body; prior values
  # restore on exit, including via error.
  assert [== $ctx->verbosity 0]
  with-ctx {verbosity 3} {
    assert [== $ctx->verbosity 3]
  }
  assert [== $ctx->verbosity 0]
  try {
    with-ctx {verbosity 99} { error escape }
  } _ {}
  assert [== $ctx->verbosity 0]

  # ----- macros -----
  # `defmacro` (see top of file) rewrites at compile time. `unless` is
  # implemented as a one-line macro; the expansion `[if cond {} body]`
  # is what actually runs.
  mut hit 0
  unless [== 1 2] { set hit 5 }
  assert [== $hit 5]
  unless [== 1 1] { set hit 99 }
  assert [== $hit 5]

  # ----- interpret / sandbox -----
  # `[interpret SRC]` compiles and runs SRC in a child VM with the
  # default prelude. `[interpret PRELUDE SRC]` restricts to the
  # entries in PRELUDE, so an empty map yields a no-I/O sandbox.
  # `[interpret-prelude]` returns the default prelude as a map, so
  # you can derive subsets by `map-remove` / `map-set`.
  assert [== [interpret "[+ 1 [* 2 3]]"] 7]
  assert [== [interpret [map] "[+ 10 20]"] 30]
  # Blocked primitives surface as error values rather than aborting.
  def safe [map-remove [interpret-prelude] "spawn"]
  assert [error? [interpret $safe "[spawn { 99 }]"]]
}

main

# Concurrency lives at top level rather than inside `main` because the
# tour's `main` redefines a few names across sections (e.g. `counter`
# as both `mut` and `atom`) and SM compilation routes both shadows
# through a single state field. The for-loop and positional-vector-
# destructure bugs the apology used to mention are fixed (see
# sm_for_explicit_binding.jacl and sm_destructure_vec.jacl); the
# remaining sharp edge is name-shadowing across SM state fields.

# ----- spawn / await -----
# `spawn { block }` returns a future. `await` blocks until it resolves.
# Spawned tasks run on the NxM worker pool and snapshot `$ctx`.
def fut [spawn { + 20 22 }]
assert [== [await $fut] 42]

# ----- direct-style: calling suspending procs -----
# Procs that internally await are themselves suspending — but the
# CPS transform makes that invisible at the call site. `double-async`
# is defined above using `spawn`/`await`; here we just call it like a
# plain function. No `await` keyword, no `.then()`, no async coloring.
assert [== [double-async 21] 42]

# Suspending procs compose like normal procs. `sum-async` calls
# `double-async` twice inline as args to `+`; the arithmetic reads as
# sequential code even though each call suspends to a worker.
assert [== [sum-async 10 16] 52]

# ----- parallel -----
# `parallel { } { } ...` runs all blocks concurrently and returns a
# vector of results in argument order, regardless of finish order.
assert [== [parallel { 10 } { 20 } { 30 }] [vec 10 20 30]]

# ----- race -----
# `race { } { } ...` returns the first to complete. Bodies should be
# deterministic for testability — both branches return the same value.
assert [== [race { 7 } { 7 }] 7]

# ----- error in parallel -----
# `parallel` runs every branch to completion; the result vector may
# contain errors. Caller decides how to handle.
def results [parallel { + 1 1 } { error boom }]
assert [error? [vec-get $results 1]]
