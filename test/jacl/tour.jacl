# mode: concurrent

##
## tour.jacl — a survey of JACL syntax. Linked from AGENTS.md.
## Each section exercises one feature area with `assert` calls.
## A failing assert halts the VM with "assertion failed" pointing at
## the source line, so a regression in any feature shows up directly.
## See SYNTAX.md for the full reference.
##
## Tagged `# mode: concurrent` so the harness runs the full scheduler
## (required for the spawn / parallel / race section at the end).
##
## Struct-valued bindings must live inside a proc, so the body of
## this tour is wrapped in `main`.
##

struct Pt {i32 x, i32 y}

proc add {a, b} { + $a $b }
proc greet {name} { concat "hi " $name }
proc zero-arg {} { + 10 20 }

# Variadic: `..rest` in params collects trailing args into a vector.
proc sum-all {..nums} {
  mut total 0
  for $nums n { set total [+ $total $n] }
  $total
}

# A suspending proc: contains `await` internally. Callers don't see
# any async machinery — they just call it like a normal function and
# get a value back. This is the direct-style payoff of CPS.
proc double-async {n} {
  def f [spawn { * $n 2 }]
  await $f
}

# Suspending procs compose with each other. The intermediate bindings
# are explicit — passing two suspending calls inline as args to the
# same outer call currently hits a CPS arg-evaluation bug (the second
# result corrupts the first). Workaround: bind first.
proc sum-async {a, b} {
  def x [double-async $a]
  def y [double-async $b]
  + $x $y
}

proc main {} {
  # ----- values -----
  # Numbers, strings, booleans, vectors.
  assert [== 42 42]
  assert [== "hi" "hi"]
  assert $true
  assert [not $false]
  assert [== [vec 1 2 3] [vec 1 2 3]]

  # ----- bindings -----
  # `def` immutable, `mut` mutable, `set` reassigns. The `=`/`:`/`::`
  # operators are command-mode sugar for these.
  def imm 7
  assert ($imm == 7)
  also = 11                       # `=` is `def` sugar
  assert ($also == 11)
  mut counter 0
  set counter 2
  assert ($counter == 2)
  reassignable : 0                # `:` is `mut` sugar
  reassignable :: 5               # `::` is `set` sugar
  assert ($reassignable == 5)

  # ----- three modes -----
  # `[]` juxtaposition: head + args. `{}` command mode: bare commands.
  # `()` infix: no precedence, left-to-right.
  assert ([+ 1 [* 2 [+ 1 3]]] == 9)
  assert ((1 + 2 + 4) == 7)
  assert ((1 + 2 * 2) == 6)       # ((1+2)*2) — no precedence

  # ----- string interpolation -----
  # `$var`, `$[...]` (juxtaposition), `$(...)` (infix) all nest in "".
  def who "alice"
  def yrs 31
  assert ("name=$who age=$yrs sum=$(2 + 3)" == "name=alice age=31 sum=5")

  # ----- procs -----
  # Params and body are both `{}` blocks. Type-before-name everywhere.
  # Procs are defined at module level (see above).
  assert ([add 20 30] == 50)
  assert ([greet "bob"] == "hi bob")
  assert ([zero-arg] == 30)

  # ----- variadic + splat -----
  # `..nums` in params collects trailing args. `..$vec` at a call site
  # spreads a collection into separate args.
  assert ([sum-all 1 2 3 4] == 10)
  def xs [vec 5 10 15]
  assert ([sum-all ..$xs] == 30)

  # ----- lambdas -----
  # `[\ body ]` is shorthand for a one-arg proc with `$it` as the param.
  def square [\ * $it $it]
  assert ([square 10] == 100)
  assert [== [collect [transform [vec 1 2 3] [\ * $it 2]]] [vec 2 4 6]]

  # ----- if / while -----
  # `if` is an expression. `while [cond] {body}`.
  assert ([if (5 > 0) { "positive" } { "non-positive" }] == "positive")
  mut sum 0
  mut i 1
  while [<= $i 10] {
    set sum [+ $sum $i]
    set i [+ $i 1]
  }
  assert ($sum == 55)

  # ----- for -----
  # Three relevant forms: implicit `$it`, explicit binding, C-style.
  # Works on vectors, streams, and ranges.
  mut seen 0
  for [vec 1 2 3] { set seen [+ $seen $it] }
  assert ($seen == 6)
  mut range-sum 0
  for (0 ..< 3) n { set range-sum [+ $range-sum $n] }
  assert ($range-sum == 3)

  # ----- streams -----
  # Lazy sequences from generators (`yield`), ranges, or `lines`.
  # `collect` materializes; `filter`/`transform` work on either.
  assert [== [collect (1 ..= 5)] [vec 1 2 3 4 5]]
  assert [== [collect [transform (1 ..= 5) [\ * $it 2]]] [vec 2 4 6 8 10]]
  assert [== [collect [transform [filter (1 ..= 6) [\ == 0 ($it % 2)]] [\ * $it $it]]] [vec 4 16 36]]

  # ----- destructuring -----
  # Positional `[]` for vectors; named `{}` for structs/maps;
  # `_` wildcard; `..rest` for trailing remainder.
  def [a b c] [vec 1 2 3]
  assert (($a == 1) && (($b == 2) && ($c == 3)))
  def p [Pt 10 20]
  def {x, y} $p
  assert (($x == 10) && ($y == 20))
  def [head ..tail] [vec "first" "second" "third"]
  assert ($head == "first")
  assert [== $tail [vec "second" "third"]]

  # ----- structs -----
  # `struct Name {type field, ...}` at module level. Constructor
  # `[Name vals...]`. Field access via `->`.
  def pt [Pt 3 4]
  assert ($pt->x == 3)
  assert ($pt->y == 4)

  # ----- maps -----
  # `[map "k" v "k2" v2 ...]`. `map-get` reads; `->` is sugar for
  # string keys.
  def m [map "a" 1 "b" 2]
  assert ([map-get $m "a"] == 1)
  def cfg [map "port" 42]
  assert ($cfg->port == 42)

  # ----- typed collections -----
  # `[Vec T]` / `[Map V]` parameterize element / value type. The typed
  # binding requires the typed constructor (`[[Vec i32] ...]`), and the
  # compiler checks element types at push/set sites. Untyped `[vec ...]`
  # / `[map ...]` still work for dyn-everything use.
  def [Vec i32] typed-nums [[Vec i32] 10 20 30]
  assert ([vec-get $typed-nums 1] == 20)
  def [Map Pt] coords [[Map Pt] "origin" [Pt 0 0] "right" [Pt 1 0]]
  assert ([map-get $coords "right"]->x == 1)

  # ----- mutable state -----
  # `box` is thread-local; `atom` is CAS-shared. `reset` stores;
  # `swap` applies a fn. `deref` reads.
  def cell [box 0]
  assert ([deref $cell] == 0)
  reset $cell 1
  assert ([deref $cell] == 1)
  swap $cell [\ + $it 5]
  assert ([deref $cell] == 6)

  # ----- atom watchers -----
  # `watch` registers a keyed listener that fires on every reset/swap
  # with (old, new) in the writing thread. `$env` and `$pwd` are built
  # on the same mechanism.
  def witness [box 0]
  def counter [atom 0]
  tap = proc {old, new} { reset $witness $new }
  watch $counter "tap" $tap
  reset $counter 7
  assert ([deref $witness] == 7)
  swap $counter [\ + $it 5]
  assert ([deref $witness] == 12)

  # ----- errors -----
  # `try {body} name {handler}`. Errors are values; pipes short-circuit.
  # `assert` halts the VM, but `error` produces an error VALUE that
  # propagates through pipes and can be caught.
  assert ([try { error "bad" } e { concat "caught: " [error-val $e] }] == "caught: bad")
  assert [error? [error "boom"]]
}

main

# Concurrency lives at top level rather than inside `main` because
# putting a suspending call (spawn/parallel/race) inside a proc body
# routes that proc through state-machine compilation, which currently
# has open bugs around `for` explicit-binding and positional
# destructuring of vector results. Top-level SM compilation is robust
# for these primitives, so we exercise them here.

# ----- spawn / await -----
# `spawn { block }` returns a future. `await` blocks until it resolves.
# Spawned tasks run on the NxM worker pool and snapshot `$ctx`.
def fut [spawn { + 20 22 }]
assert ([await $fut] == 42)

# ----- direct-style: calling suspending procs -----
# Procs that internally await are themselves suspending — but the
# CPS transform makes that invisible at the call site. `double-async`
# is defined above using `spawn`/`await`; here we just call it like a
# plain function. No `await` keyword, no `.then()`, no async coloring.
assert ([double-async 21] == 42)

# Suspending procs compose like normal procs. `sum-async` calls
# `double-async` twice inline; the arithmetic reads as sequential code
# even though each call suspends to a worker.
assert ([sum-async 10 16] == 52)

# ----- parallel -----
# `parallel { } { } ...` runs all blocks concurrently and returns a
# vector of results in argument order, regardless of finish order.
assert [== [parallel { 10 } { 20 } { 30 }] [vec 10 20 30]]

# ----- race -----
# `race { } { } ...` returns the first to complete. Bodies should be
# deterministic for testability — both branches return the same value.
assert ([race { 7 } { 7 }] == 7)

# ----- error in parallel -----
# `parallel` runs every branch to completion; the result vector may
# contain errors. Caller decides how to handle.
def results [parallel { + 1 1 } { error "boom" }]
assert [error? [vec-get $results 1]]
