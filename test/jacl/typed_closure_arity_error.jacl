# expect-error: parameter
# Conformance (TYPED_CLOSURES_DESIGN.md §2.3, invariant): an inline literal's
# arity must match the declared [Proc …] type. Here the type declares two
# params but the literal has one — a compile error, not a confusing runtime
# arity fault at the call site.
proc main {} {
  def [Proc [i64 i64] i64] f [proc {x} {* $x 2}]
  print [f 3 4]
}
main
