# expect-error: conforming
# An [Arr [Proc …]] element must conform to the declared element signature
# (invariant). Here a named [Proc [f64] f64] closure is placed in an
# [Arr [Proc [i64] i64]] — a compile error. Mirrors typed_closure_vec_error.
proc main {} {
  def [Proc [f64] f64] g [proc {n} {* $n 2.0}]
  def [Arr [Proc [i64] i64]] fns [[Arr [Proc [i64] i64]] $g]
  for $fns f { print [f 1] }
}
main
