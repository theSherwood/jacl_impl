# expect: 6000000000
# expect: 6000000001
# expect: 7
# expect: 6.5
# expect: hibye
# expect: 99
# expect: 8
# expect: 12
# Typed closure VALUES via [Proc [P…] R] annotations (TYPED_CLOSURES_DESIGN.md
# Phase B). An inline proc literal bound under a [Proc …] type is monomorphized
# to the declared param/return types and called through the typed (unboxed)
# convention — no boxing across the closure boundary.
proc main [] [
  # Wide i64: the param is read wide and the i64 result (> INT32_MAX) flows
  # back unboxed. A regression to the dyn path would still print the value, so
  # the strict-i64 consumer below is the real proof.
  def [Proc [i64] i64] f [proc [x] [* $x 1000000000]]
  print [f 6]                       # 6_000_000_000

  # The call narrows to the declared i64 return — storing it in a strict i64
  # binding (no-autobox) only type-checks if [f 6] is genuinely i64.
  def i64 y [f 6]
  print [+ $y 1]                    # 6_000_000_001

  # Multiple params.
  def [Proc [i64 i64] i64] add [proc [a b] [+ $a $b]]
  print [add 3 4]                   # 7

  # f64 param + return.
  def [Proc [f64] f64] half [proc [x] [/ $x 2.0]]
  print [half 13.0]                 # 6.5

  # str param + return.
  def [Proc [str str] str] cat [proc [a b] [concat $a $b]]
  print [cat "hi" "bye"]            # hibye

  # Nilary form [Proc [] R]: the bare-literal tail narrows to the return type.
  def [Proc [] i64] g [proc [] [99]]
  print [g]                         # 99

  # dyn is an ordinary type (§2.5): [Proc [dyn] dyn] is the status-quo closure.
  def [Proc [dyn] dyn] id [proc [x] [$x]]
  print [id 8]                      # 8

  # An explicitly-typed literal param that MATCHES the annotation is fine
  # (conformance, not re-typing).
  def [Proc [i64] i64] dbl [proc [i64 x] [* $x 2]]
  print [dbl 6]                     # 12
]
main
