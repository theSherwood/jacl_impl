# expect: 3
# An [Arr T] param inside a [Proc …] works like [Vec T] (single element type),
# with element conformance enforced ([Arr i32] does not conform to [Arr i64]).
proc suma [[Arr i64] a] i64 [ [arr-get $a 0] ]
proc hof  [[Proc [[Arr i64]] i64] f, [Arr i64] a] i64 [ [f $a] ]
proc main [] [
  def [Arr i64] a [[Arr i64] 3 4]
  print [hof $suma $a]
]
main
