# expect: 10
# expect: 14
# expect: 6
# expect: 8
# expect: 30
# Global procs as first-class closure values. A top-level proc referenced by
# name (`$dbl`) is a closure value carrying the proc's signature, so it can be
# assigned to a [Proc …] binding, passed directly to a [Proc …] param, and
# stored as a typed-collection element — the typer narrows the `$name` ref
# instead of leaving it dyn. A FORWARD reference (using a proc as a value before
# its textual definition, e.g. `$later` below) also works: the typer's
# whole-program pre-pass already knows every proc's signature, and the compiler
# conforms the use site against the typer's portable shape stamp. This makes
# higher-order mutual recursion expressible. (Only registered procs narrow this
# way; a forward ref to a mutable/immutable BINDING or an undefined name stays a
# hard compile error — see typed_closure_global_proc_fwd_*_err.jacl.)
struct Point {i32 x, i32 y}
proc dbl   {i32 x} i32   { [* $x 2] }
proc shift {Point p} Point { [Point x [+ $p->x 1] y $p->y] }
proc apply {[Proc [i32] i32] f, i32 n} i32 { [f $n] }
proc applyp {[Proc [Point] Point] f, Point p} Point { [f $p] }

proc main {} {
  # Pass a named proc directly to a [Proc …] param.
  print [apply $dbl 5]                                   # 10

  # Assign a named proc to a typed [Proc …] binding, then use it.
  def [Proc [i32] i32] g $dbl
  print [apply $g 7]                                     # 14

  # Struct-signature proc passed by name (field access on the struct return).
  print [applyp $shift [Point x 5 y 9]]->x               # 6

  # Store named procs in a [Vec [Proc …]] and call an element.
  def [Vec [Proc [i32] i32]] fns [[Vec [Proc [i32] i32]] $dbl]
  print [[vec-get $fns 0] 4]                             # 8

  # FORWARD reference: `later` is a proc defined AFTER main, used here as a
  # value. The conformance falls back to the typer's portable shape stamp.
  print [apply $later 10]                                # 30
}
# Defined after `main` — a forward reference when used as `$later` above.
proc later {i32 x} i32 { [* $x 3] }
main
