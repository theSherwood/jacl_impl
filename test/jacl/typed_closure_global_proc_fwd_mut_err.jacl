# expect-error: expected closure, got dyn
# A FORWARD reference to a global MUTABLE binding used as a closure value is a
# hard compile error. Only registered procs are hoisted whole-program and narrow
# forward; a `mut`/`def` BINDING referenced before its definition stays `dyn` and
# dies at the typer — the proc-value forward-ref support must NOT leak to it.
proc dbl {i32 x} i32 { [* $x 2] }
proc run {[Proc [i32] i32] f, i32 n} i32 { [f $n] }
proc main {} { print [run $g 5] }
mut [Proc [i32] i32] g $dbl
main
