# expect: 10
# expect: 15
# expect: 8
# expect: 100
# A `mut` binding of a known-signature closure inherits the signature, exactly
# like `def` — so it is passable to a [Proc …] sink, not just callable. And
# because the binding is typed, REASSIGNMENT must conform to it (a non-conforming
# closure is rejected — see typed_closure_mut_reassign_err.jacl). A fully-
# unannotated literal value keeps the binding `dyn` (freely reassignable).
proc dbl   [i32 x] i32 [ [* $x 2] ]
proc halve [i32 x] i32 [ [/ $x 2] ]
proc apply [[Proc [i32] i32] f, i32 n] i32 [ [f $n] ]

proc main [] [
  # Named proc → typed mut binding, passable.
  mut f $dbl
  print [apply $f 5]                                     # 10

  # Annotated inline literal → typed mut binding.
  mut lit [proc [i32 x] i32 [ [* $x 3] ]]
  print [apply $lit 5]                                   # 15

  # Propagated element signature via vec-get.
  def [Vec [Proc [i32] i32]] fns [[Vec [Proc [i32] i32]] $dbl]
  mut g [vec-get $fns 0]
  print [apply $g 4]                                     # 8

  # Reassign the typed mut binding to a CONFORMING closure — allowed.
  set f $halve
  set f [proc [i32 x] i32 [ [* $x 5] ]]
  print [apply $f 20]                                    # 100
]
main
