# expect: 7
# expect: 9
# Dyn-inferred struct param in [Proc …] (remaining item). A closure literal that
# leaves a param UNTYPED (`{q}`) adopts the struct type the [Proc …] annotation
# declares for it (`[Proc [Point] i32]` ⇒ q : Point), so `$q->field` resolves in
# the body — no need to restate the struct type on the literal. Covered for the
# def-binding form (the previously-failing case: the def-site walk used to type
# the body with q dyn and raise a premature "body returns dyn") and the inline
# closure-arg form. (A [Vec [Proc …]] element literal that BOTH omits its struct
# param type AND declares a return still errors in the ctor walk — a smaller
# remaining sub-item; declare the struct param there for now.)
struct Point {i32 x, i32 y}
proc apply {[Proc [Point] i32] f, Point p} i32 { [f $p] }

proc main {} {
  # def-binding form: q is inferred Point from the annotation.
  def [Proc [Point] i32] g [proc {q} i32 { $q->x }]
  print [apply $g [Point x 7 y 2]]                    # 7

  # inline closure-arg form: same inference at the call site.
  print [apply [proc {q} i32 { [+ $q->x $q->y] }] [Point x 4 y 5]]   # 9
}
main
