# expect: 20
# expect: 11
# expect: 6000000000
# expect: 9
# expect: 20
# Collections of closures: [Vec [Proc …]] (TYPED_CLOSURES_DESIGN.md Phase B3c).
# Closures are ref-kind (tagged heap pointers) → plain traced vec rep with the
# element signature carried statically. Inline-literal elements are
# monomorphized to the element signature; named typed-closure elements are
# conformance-checked. A for-loop narrows the binding to a typed closure, so
# calling an element is a typed (unboxed) call.
proc main {} {
  def [Vec [Proc [i64] i64]] fns [[Vec [Proc [i64] i64]] [proc {x} {* $x 2}] [proc {x} {+ $x 1}]]
  for $fns f { print [f 10] }              # 20, 11

  # Wide-i64 element proves the element call is unboxed; a plain closure too.
  def [Vec [Proc [i64] i64]] more [[Vec [Proc [i64] i64]] [proc {x} {* $x 1000000000}] [proc {x} {+ $x 3}]]
  for $more g { print [g 6] }              # 6_000_000_000, 9

  # A NAMED typed closure as an element (conformance-checked).
  def [Proc [i64] i64] dbl [proc {n} {* $n 2}]
  def [Vec [Proc [i64] i64]] named [[Vec [Proc [i64] i64]] $dbl]
  for $named h { print [h 10] }            # 20
}
main
