# expect: 42
# expect: 11
# expect: 6000000000
# expect: 12
# Collections of closures, get + push follow-ups (TYPED_CLOSURES_DESIGN.md
# Phase B3c). vec-get on a [Vec [Proc …]] narrows the result to a typed closure,
# so a bound element is a typed (unboxed) call. A closure literal pushed via
# vec-push is monomorphized to the element signature (its param is unboxed, not
# read as nil); the annotated result vec narrows on read-back. Wide-i64 elements
# prove the element calls are unboxed.
proc main {} {
  def [Vec [Proc [i64] i64]] fns [[Vec [Proc [i64] i64]] [proc {x} {* $x 2}] [proc {x} {+ $x 1}]]

  # vec-get narrowing: bind an element, then a typed call on it.
  def g [vec-get $fns 0]
  print [g 21]                              # 42
  def h [vec-get $fns 1]
  print [h 10]                              # 11

  # vec-push monomorphization: push a wide-i64 closure literal (proves unboxed),
  # then read it — and an original element — back out of the annotated result
  # vec and call them typed.
  def [Vec [Proc [i64] i64]] more [vec-push $fns [proc {x} {* $x 1000000000}]]
  def w [vec-get $more 2]
  print [w 6]                               # 6000000000
  def v [vec-get $more 0]
  print [v 6]                               # 12
}
main
