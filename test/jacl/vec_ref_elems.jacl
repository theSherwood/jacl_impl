# expect: [vec "a" "b"]
# expect: true
# expect: [vec 1 "two" 3]
# expect: true
# expect: ab
# expect: x
# expect: y
# expect: ok
# Ref-element typed vecs (`vec` is shorthand for [Vec dyn]; the whole [Vec T]
# family is legal). Ref elements (str, dyn) share the plain traced vec REP —
# no strided rep win exists for tagged heap values — and the element type
# lives statically: constructor element checks, for-binding narrowing.
# Value-type elements ([Vec i64], [Vec Pt]) keep the strided rep as before.
proc main {} {
  def sv [[Vec str] "a" "b"]
  print $sv                          # plain-vec rep => plain print format
  print [== $sv [vec "a" "b"]]       # same runtime type => structural eq

  def dv [[Vec dyn] 1 "two" 3]       # [Vec dyn] IS the plain vec
  print $dv
  print [== $dv [vec 1 "two" 3]]

  # for-binding narrows to str via the static element stamp
  mut s ""
  for $sv c {
    assert-type $c str
    set s [concat $s $c]
  }
  print $s                           # ab

  # collect [Stream str] (lines) is statically [Vec str] now — binding narrows
  for [collect [lines "x\ny"]] l {
    assert-type $l str
    print $l                         # x y
  }
  print "ok"
}
main
