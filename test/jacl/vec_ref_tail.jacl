# expect: 9
# expect: a
# expect: 5
# expect: ok
# Tail of the vec-type unification: depth-3 nested element types, explicit
# [Vec T] annotations, and vec-get narrowing on stamped ref-element vecs.
proc main [] [
  # depth-3: [Vec [Vec [Vec i64]]] — narrowing recurses through bindings
  def d3 [[Vec [Vec [Vec i64]]] [[Vec [Vec i64]] [[Vec i64] 4 5]]]
  mut i64 t 0
  for $d3 plane [
    for $plane row [
      for $row x [ set t [+ $t $x] ]
    ]
  ]
  print $t                              # 4 + 5 = 9

  # explicit annotation: def [Vec str] — binding carries the element type
  def [Vec str] names [[Vec str] "a" "b"]
  for $names n [
    assert-type $n str
  ]
  # vec-get narrows on the stamped vec (assert on the expression — plain
  # def doesn't propagate tagged-scalar types into bindings, by design)
  assert-type [vec-get $names 0] str
  print [vec-get $names 0]              # a

  # annotation with a nested element type
  def [Vec [Vec i64]] m [[Vec [Vec i64]] [[Vec i64] 2 3]]
  mut i64 s 0
  for $m row [ for $row v [ set s [+ $s $v] ] ]
  print $s                              # 5
  print "ok"
]
main
